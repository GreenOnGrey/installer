    {
      "type": "table",
      "title": "Топ профилей по сигналам за неделю",
      "description": "Сами пакеты — в админке Nabu, раздел «Образы песочниц»: в метрики имена пакетов не попадают",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "topk(10, sum by (profile, ecosystem) (increase(nabu_sandbox_package_signals_total{result=\"ok\"}[7d])))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "сигналов"
            }
          }
        }
      ]
    }
