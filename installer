#!/usr/bin/env bash
# Installs GreenOnGrey products on minikube or an existing cluster (FTR.HMR.INFRA-0001, FTR.INFRA.INST-0001).
#   ./installer install | status | creds | uninstall | help
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib/common.sh
source "$ROOT/lib/common.sh"
# shellcheck source=lib/host.sh
source "$ROOT/lib/host.sh"
# shellcheck source=lib/prereqs.sh
source "$ROOT/lib/prereqs.sh"
# shellcheck source=lib/cluster.sh
source "$ROOT/lib/cluster.sh"
# shellcheck source=lib/secrets.sh
source "$ROOT/lib/secrets.sh"
# shellcheck source=lib/external.sh
source "$ROOT/lib/external.sh"
# shellcheck source=lib/checks.sh
source "$ROOT/lib/checks.sh"
# shellcheck source=lib/preflight.sh
source "$ROOT/lib/preflight.sh"
# shellcheck source=lib/state.sh
source "$ROOT/lib/state.sh"
# shellcheck source=lib/deploy.sh
source "$ROOT/lib/deploy.sh"
# shellcheck source=lib/public.sh
source "$ROOT/lib/public.sh"
# shellcheck source=lib/mcp.sh
source "$ROOT/lib/mcp.sh"
# shellcheck source=lib/uninstall.sh
source "$ROOT/lib/uninstall.sh"
# shellcheck source=lib/product.sh
source "$ROOT/lib/product.sh"

usage() {
  cat <<'EOF'
Usage: ./installer <command> [flags]

Commands:
  install    check the machine or the cluster, install dependencies, deploy, verify, print a summary;
             no questions, safe to repeat
  status     show the state of the cluster and components, run the checks, show resources
  creds      print addresses, secret names and passwords from Kubernetes secrets
  uninstall  remove what the installer installed: on minikube the profile with all its data, on an
             existing cluster its releases and namespaces; external storages and their data stay
  help       show this help

Flags:
  --config <file>  configuration file (default: $INSTALLER_CONFIG, then /etc/greenongrey/installer.env
                   if it exists, then config/local.env)
  --yes            uninstall: do not ask for confirmation; required without a terminal
  --json           status, creds: print JSON
  --verbose        print the commands being run
  --no-color       disable color (automatic when the output is not a terminal)

install and uninstall end stdout with one line of JSON: status, command, code, durationSeconds,
installerVersion, updated, failed, skipped, diagnostics.
EOF
}

usage_error() {
  printf 'Error: %s\n\n' "$1" >&2
  usage >&2
  exit "$E_USAGE"
}

COMMAND="" CONFIG_FILE="" ASSUME_YES=0 JSON=0
SYSTEM_CONFIG=${SYSTEM_CONFIG:-/etc/greenongrey/installer.env}

# default_config — INSTALLER_CONFIG, the system file, then the file of the checkout.
default_config() {
  if [[ -n ${INSTALLER_CONFIG:-} ]]; then
    [[ -f $INSTALLER_CONFIG ]] || usage_error "INSTALLER_CONFIG: file not found: $INSTALLER_CONFIG"
    echo "$INSTALLER_CONFIG"
  elif [[ -f $SYSTEM_CONFIG ]]; then
    echo "$SYSTEM_CONFIG"
  else
    echo "$ROOT/config/local.env"
  fi
}

parse_args() {
  local arg
  while (($#)); do
    arg=$1
    # Hidden synonyms: deploy-remote.sh of older tags runs up.
    case $arg in
      up) arg=install ;;
      down) arg=uninstall ;;
    esac
    case $arg in
      install | status | creds | uninstall | help)
        [[ -n $COMMAND ]] && usage_error "unexpected extra command: $1"
        COMMAND=$arg
        ;;
      --config)
        [[ $# -ge 2 ]] || usage_error "--config needs a file path"
        CONFIG_FILE=$2
        shift
        ;;
      --config=*) CONFIG_FILE=${1#--config=} ;;
      --yes) ASSUME_YES=1 ;;
      --json) JSON=1 ;;
      --verbose) VERBOSE=1 ;;
      --no-color) COLOR=0 ;;
      -h | --help) COMMAND=help ;;
      *) usage_error "unknown command or flag: $1" ;;
    esac
    shift
  done
  # The wizard comes with a later release (FTR.INFRA.INST-0001 R3); until then no command is a usage error.
  [[ -n $COMMAND ]] || usage_error "no command given"
  [[ $ASSUME_YES == 1 && $COMMAND != uninstall ]] && usage_error "--yes is only valid for uninstall"
  [[ $JSON == 1 && $COMMAND != status && $COMMAND != creds ]] && usage_error "--json is only valid for status and creds"
  if [[ -n $CONFIG_FILE && ! -f $CONFIG_FILE ]]; then usage_error "config file not found: $CONFIG_FILE"; fi
  CONFIG_FILE=${CONFIG_FILE:-$(default_config)}
  return 0
}

# interactive — input and output are a terminal: questions are allowed.
interactive() { [[ -t 0 && -t 1 ]]; }

# --- JSON result (FTR.INFRA.INST-0001 tech §2.2) ---

RESULT_UPDATED=() RESULT_FAILED=() RESULT_SKIPPED=() RESULT_DIAGNOSTICS=""
COMMAND_STARTED=$SECONDS

# json_array <items…> — a JSON array of strings.
json_array() { if (($#)); then printf '%s\n' "$@" | jq -R . | jq -cs .; else echo '[]'; fi; }

# print_result <code> — the last line of stdout of a command that changes the system. Without jq
# (a failed check of a clean machine comes before the dependencies) the lists are empty.
print_result() {
  local code=$1
  if ! have jq; then
    printf '{"status":"%s","command":"%s","code":%d,"durationSeconds":%d,"installerVersion":"%s","updated":[],"failed":[],"skipped":[],"diagnostics":null}\n' \
      "$(if ((code == 0)); then echo ok; else echo failed; fi)" "$COMMAND" "$code" $((SECONDS - COMMAND_STARTED)) "$(installer_version | tr -cd 'A-Za-z0-9._-')"
    return
  fi
  jq -cn --arg command "$COMMAND" --argjson code "$code" --argjson took $((SECONDS - COMMAND_STARTED)) \
    --arg version "$(installer_version)" --argjson updated "$(json_array "${RESULT_UPDATED[@]}")" \
    --argjson failed "$(json_array "${RESULT_FAILED[@]}")" --argjson skipped "$(json_array "${RESULT_SKIPPED[@]}")" \
    --arg diagnostics "$RESULT_DIAGNOSTICS" \
    '{status: (if $code == 0 then "ok" else "failed" end), command: $command, code: $code, durationSeconds: $took,
      installerVersion: $version, updated: $updated, failed: $failed, skipped: $skipped,
      diagnostics: (if $diagnostics == "" then null else $diagnostics end)}'
}

# --- install ---

OLD_LOCK_FILE=${OLD_LOCK_FILE:-/var/lock/hammurapi-infra.lock}

acquire_lock() {
  # An external target changes nothing on the machine, /var/lock included.
  if target_external; then
    LOCK_FILE=$WORK_DIR/installer.lock
  elif [[ ! -w $LOCK_FILE ]]; then
    as_root touch "$LOCK_FILE"
    as_root chmod 0666 "$LOCK_FILE"
  fi
  exec 9>>"$LOCK_FILE"
  flock -n 9 || die "$E_LOCKED" "another run of the installer is already running ($LOCK_FILE)"
  # An up of a tag before the rename holds the old file (FTR.INFRA.INST-0001 tech §9).
  if [[ -w $OLD_LOCK_FILE ]]; then
    exec 8>>"$OLD_LOCK_FILE"
    flock -n 8 || die "$E_LOCKED" "another run of the installer is already running ($OLD_LOCK_FILE)"
  fi
}

collect_diagnostics() {
  have kubectl || return 0
  kc get nodes >/dev/null 2>&1 || return 0
  local dir=$RUN_DIR/diagnostics pod ns rel
  mkdir -p "$dir"
  kc get events -A --sort-by=.lastTimestamp >"$dir/events.txt" 2>&1 || true
  kc get pods -A -o wide >"$dir/pods.txt" 2>&1 || true
  for ns in $(stand_namespaces); do
    while read -r pod; do
      [[ -n $pod ]] || continue
      kc -n "$ns" describe pod "$pod" >"$dir/describe-$ns-$pod.txt" 2>&1 || true
      # Logs of all containers: the current run and the previous one (for CrashLoopBackOff).
      kc -n "$ns" logs "$pod" --all-containers --prefix --tail=300 >"$dir/logs-$ns-$pod.txt" 2>&1 || true
      kc -n "$ns" logs "$pod" --all-containers --prefix --tail=300 --previous >"$dir/logs-$ns-$pod-previous.txt" 2>&1 || true
    done < <(kc -n "$ns" get pods --no-headers 2>/dev/null |
      awk '{split($2, r, "/"); if (r[1] != r[2] && $3 != "Completed") print $1}')
  done
  while read -r rel ns; do
    [[ -n $rel ]] && hm status "$rel" -n "$ns" >"$dir/helm-status-$rel.txt" 2>&1 || true
  done < <(hm list -A -o json 2>/dev/null | jq -r '.[] | "\(.name) \(.namespace)"' 2>/dev/null)
  RESULT_DIAGNOSTICS=$dir
  warn "diagnostics saved to $dir"
}

on_install_exit() {
  local code=$1
  preflight_cleanup
  if ((code != 0)); then
    STEP=main
    collect_diagnostics
    [[ -n $RESULT_DIAGNOSTICS ]] || RESULT_DIAGNOSTICS=$RUN_DIR/run.log
    warn "$COMMAND failed with code $code; log: $RUN_DIR/run.log"
  fi
  print_result "$code"
}

# start_run_log — logs/<time>/run.log gets all output of the command.
start_run_log() {
  RUN_DIR="${LOGS_DIR:-$ROOT/logs}/$(date -u +%Y%m%dT%H%M%SZ)"
  mkdir -p "$RUN_DIR"
  exec > >(tee -a "$RUN_DIR/run.log") 2>&1
  log "run log: $RUN_DIR/run.log"
}

print_summary() {
  local took=$((SECONDS - COMMAND_STARTED)) mode r name ver
  mode="Postgres: $(mode_label "$POSTGRES_MODE"), Kafka: $(mode_label "$KAFKA_MODE"), S3: $(mode_label "$S3_MODE")"
  local ns=$NS_STORAGES res
  res=$(resources_line)
  cat <<EOF

Ready in $(human_duration "$took"). Version: ${DEPLOYED_TAG:-dev}.

Cluster       $(if target_external; then echo "context $KUBE_CONTEXT (Kubernetes $(cluster_k8s_version))"; else echo "minikube $MK_PROFILE (Kubernetes $K8S_VERSION), $MK_CPUS CPU / ${MK_MEMORY^^}"; fi)
Storages      postgres.$ns.svc:5432  kafka.$ns.svc:9092  s3.$ns.svc:9000
              ($mode)
Observability $(if observability_enabled; then echo "Grafana, VictoriaMetrics, VictoriaLogs in namespace $NS_OBSERVABILITY"; else echo off; fi)
Resources     $res

Versions      Kafka $KAFKA_VERSION, Postgres ${POSTGRES_IMAGE##*:}, VictoriaLogs Grafana plugin $VL_PLUGIN_VERSION
EOF
  for r in "${RELEASES[@]}"; do
    read -r name ver <<<"$r"
    printf '              %-20s %s\n' "$name" "$ver"
  done
  observability_enabled && cat <<EOF

Grafana:
  on your computer: ssh -L $GRAFANA_LOCAL_PORT:localhost:$GRAFANA_LOCAL_PORT $(id -un)@<machine address>
  on this machine:  kubectl --context $(kube_context) -n $NS_OBSERVABILITY port-forward svc/grafana $GRAFANA_LOCAL_PORT:80
  then open http://localhost:$GRAFANA_LOCAL_PORT
EOF
  products_summary
  printf '\nPasswords: ./installer creds\n'
  if public_enabled; then
    cat <<EOF

Public access (certificate ${ACME_ISSUER:-letsencrypt}):
  $(if observability_enabled; then echo "https://grafana.$PUBLIC_DOMAIN   "; fi)https://${HAMMURAPI_WEB_HOST:-hammurapi}.$PUBLIC_DOMAIN   https://${HAMMURAPI_API_HOST:-hammurapi-api}.$PUBLIC_DOMAIN
  $(if ingress_external; then echo "ingress class $INGRESS_CLASS; point the hosts to its load balancer"; elif target_external; then echo "point the hosts to the load balancer $LB_IP"; else echo "ports 80/443 of this machine → Traefik $LB_IP; open them in your cloud firewall"; fi)
EOF
  fi
}

mode_label() { if [[ $1 == internal ]]; then echo built-in; else echo external; fi; }

resources_line() {
  local pct=0
  ((MEM_ALLOCATABLE > 0)) && pct=$((MEM_REQUESTED * 100 / MEM_ALLOCATABLE))
  echo "requested $(gib "$MEM_REQUESTED") GiB of $(gib "$MEM_ALLOCATABLE") GiB ($pct%)"
}

cmd_install() {
  start_run_log
  trap 'on_install_exit $?' EXIT
  if target_external; then
    acquire_lock
    preflight
    ensure_stand_namespaces
  else
    check_single_profile
    check_host
    acquire_lock
    install_prereqs
    cluster_up
  fi
  migrate_names
  restore_config strict
  validate_config
  deploy_all
  # Right after the deploy: record what was applied, even if the checks fail later.
  write_config
  if ! run_checks; then
    die "$E_CHECKS" "checks failed: $(first_failure)"
  fi
  # The stand is recorded first: a failed product leaves the stand as deployed.
  write_version
  deploy_products
  print_summary
}

# --- status ---

# public_status_json — public access as recorded in the cluster.
public_status_json() {
  local data
  data=$(state_public)
  if [[ -z $data || $data == "{}" ]]; then
    echo '{"enabled":false}'
  else
    jq -c '{enabled: true, baseDomain, publicIp, lbIp, issuer, ingressMode: (.ingressMode // "internal"), ingressClass: (.ingressClass // "traefik")}' <<<"$data"
  fi
}

deployed_version() {
  local data
  data=$(state_version)
  echo "${data:-null}"
}

cmd_status() {
  RUN_DIR=$WORK_DIR
  local running=0 profile_status
  if cluster_reachable; then running=1; fi
  profile_status=$([[ $running == 1 ]] && echo Running || echo Stopped)
  if [[ $running == 1 ]]; then
    # Component rollouts check only the stand: a failing MCP server or external search
    # must not stop a product release.
    [[ ${INSTALLER_STAND_ONLY:-} == 1 ]] || restore_config
    run_checks || true
  else
    CHECK_RESULTS=("cluster|fail|cluster $(cluster_label) is not running")
  fi
  local failed=0 r
  for r in "${CHECK_RESULTS[@]}"; do [[ $r == *"|fail|"* ]] && failed=1; done
  if [[ $JSON == 1 ]]; then
    status_json "$profile_status" "$running"
  else
    status_text "$profile_status" "$running"
  fi
  ((failed == 0)) || exit "$E_CHECKS"
}

checks_json() {
  local r name state msg
  for r in "${CHECK_RESULTS[@]}"; do
    IFS='|' read -r name state msg <<<"$r"
    jq -cn --arg n "$name" --arg s "$state" --arg m "$msg" '{name: $n, ok: ($s == "ok"), message: $m}'
  done | jq -cs .
}

status_json() {
  local profile_status=$1 running=$2 releases='[]' pods='[]' version=null public='{"enabled":false}' ns
  if [[ $running == 1 ]]; then
    releases=$(hm list -A -o json 2>/dev/null | jq -c '[.[] | {name, namespace, chart, app_version, status, revision}]' || echo '[]')
    pods=$(for ns in $(stand_namespaces); do kc get pods -n "$ns" -o json 2>/dev/null; done)
    pods=$(jq -cs '[.[].items[] | {namespace: .metadata.namespace, name: .metadata.name, phase: .status.phase,
      ready: ([.status.containerStatuses[]?.ready] | all)}]' <<<"$pods")
    version=$(deployed_version)
    public=$(public_status_json)
  fi
  local name=$MK_PROFILE k8s=$K8S_VERSION
  if target_external; then
    name=$KUBE_CONTEXT
    k8s=$(cluster_k8s_version)
  fi
  jq -n --arg profile "$name" --arg st "$profile_status" --arg k8s "$k8s" --arg target "${INSTALL_TARGET:-minikube}" \
    --argjson version "$version" --argjson releases "$releases" --argjson pods "$pods" --argjson public "$public" \
    --argjson checks "$(checks_json)" --argjson req "$MEM_REQUESTED" --argjson alloc "$MEM_ALLOCATABLE" \
    --argjson mcp "$(mcp_status_json)" \
    --arg pg "$POSTGRES_MODE" --arg kafka "$KAFKA_MODE" --arg s3 "$S3_MODE" \
    --argjson observability "$(if observability_enabled; then echo true; else echo false; fi)" \
    '{target: $target, profile: {name: $profile, status: $st, kubernetes: $k8s}, version: $version,
      storages: {postgres: $pg, kafka: $kafka, s3: $s3}, observability: $observability, public: $public, mcp: $mcp,
      releases: $releases, pods: $pods, checks: $checks,
      resources: {requestedMemoryBytes: $req, allocatableMemoryBytes: $alloc,
        requestedPercent: (if $alloc > 0 then ($req * 100 / $alloc | floor) else 0 end)},
      ok: ($checks | all(.ok))}'
}

status_text() {
  local profile_status=$1 running=$2 r name state msg
  printf '\nCluster    %s — %s\n' "$(cluster_label)" "$profile_status"
  if [[ $running == 1 ]]; then
    printf 'Version    %s\n' "$(deployed_version | jq -r 'if . == null then "not recorded" else "\(.tag) (\(.commit)), \(.deployedAt), \(.deployedBy)" end')"
    printf '\nHelm releases\n'
    hm list -A 2>/dev/null | sed 's/^/  /' || true
    printf '\nPods\n'
    kc get pods -n "$NS_STORAGES" 2>/dev/null | sed 's/^/  /' || true
    if observability_enabled; then kc get pods -n "$NS_OBSERVABILITY" --no-headers 2>/dev/null | sed 's/^/  /' || true; fi
    mcp_enabled && { kc get pods -n "$NS_MCP" --no-headers 2>/dev/null | sed 's/^/  /' || true; }
    printf '\nResources  %s\n' "$(resources_line)"
  fi
  printf '\nChecks\n'
  for r in "${CHECK_RESULTS[@]}"; do
    IFS='|' read -r name state msg <<<"$r"
    if [[ $state == ok ]]; then
      printf '  %s✓%s %-10s %s\n' "$C_GREEN" "$C_RESET" "$name" "$msg"
    else
      printf '  %s✗%s %-10s %s\n' "$C_RED" "$C_RESET" "$name" "$msg"
    fi
  done
}

# --- creds ---

cmd_creds() {
  if ! have kubectl || ! kc get ns "$NS_STORAGES" >/dev/null 2>&1; then die "$E_CHECKS" "cluster $MK_PROFILE is not running or nothing is deployed"; fi
  restore_config
  local ns=$NS_STORAGES
  local -A pg kafka s3
  local k
  for k in host port database username password sslmode uri; do pg[$k]=$(secret_key "$ns" postgres-conn "$k"); done
  for k in bootstrap_servers security_protocol sasl_mechanism username password; do kafka[$k]=$(secret_key "$ns" kafka-conn "$k"); done
  for k in endpoint region bucket access_key secret_key path_style; do s3[$k]=$(secret_key "$ns" s3-conn "$k"); done
  local gf_user="" gf_pass=""
  if observability_enabled; then
    gf_user=$(secret_key "$NS_OBSERVABILITY" grafana-admin admin-user || true)
    gf_pass=$(secret_key "$NS_OBSERVABILITY" grafana-admin admin-password || true)
  fi
  if [[ $JSON == 1 ]]; then
    jq -n \
      --arg pgsvc "postgres.$ns.svc:5432" --arg pghost "${pg[host]}" --arg pgport "${pg[port]}" --arg pgdb "${pg[database]}" \
      --arg pguser "${pg[username]}" --arg pgpass "${pg[password]}" --arg pgssl "${pg[sslmode]}" --arg pguri "${pg[uri]}" \
      --arg ksvc "kafka.$ns.svc:9092" --arg kb "${kafka[bootstrap_servers]}" --arg kp "${kafka[security_protocol]}" \
      --arg km "${kafka[sasl_mechanism]}" --arg ku "${kafka[username]}" --arg kpass "${kafka[password]}" \
      --arg ssvc "s3.$ns.svc:9000" --arg se "${s3[endpoint]}" --arg sr "${s3[region]}" --arg sb "${s3[bucket]}" \
      --arg sa "${s3[access_key]}" --arg ss "${s3[secret_key]}" --arg sp "${s3[path_style]}" \
      --arg gu "$gf_user" --arg gp "$gf_pass" --arg ns "$ns" --arg obs "$NS_OBSERVABILITY" --arg pgm "$POSTGRES_MODE" \
      --arg km2 "$KAFKA_MODE" --arg sm "$S3_MODE" --argjson mcp "$(mcp_creds_json)" \
      --argjson obs_on "$(if observability_enabled; then echo true; else echo false; fi)" \
      '{postgres: {mode: $pgm, service: $pgsvc, secret: "\($ns)/postgres-conn", host: $pghost, port: $pgport, database: $pgdb,
          username: $pguser, password: $pgpass, sslmode: $pgssl, uri: $pguri},
        kafka: {mode: $km2, service: $ksvc, secret: "\($ns)/kafka-conn", bootstrap_servers: $kb, security_protocol: $kp,
          sasl_mechanism: $km, username: $ku, password: $kpass},
        s3: {mode: $sm, service: $ssvc, secret: "\($ns)/s3-conn", endpoint: $se, region: $sr, bucket: $sb,
          access_key: $sa, secret_key: $ss, path_style: $sp},
        grafana: (if $obs_on then {service: "grafana.\($obs).svc:80", secret: "\($obs)/grafana-admin", user: $gu, password: $gp} else null end),
        mcp: $mcp}'
    return
  fi
  cat <<EOF
Postgres ($(mode_label "$POSTGRES_MODE"))
  service   postgres.$ns.svc:5432     secret $ns/postgres-conn
  host      ${pg[host]}:${pg[port]}   database ${pg[database]}   sslmode ${pg[sslmode]}
  username  ${pg[username]}
  password  ${pg[password]}
  uri       ${pg[uri]}

Kafka ($(mode_label "$KAFKA_MODE"))
  service   kafka.$ns.svc:9092        secret $ns/kafka-conn
  bootstrap ${kafka[bootstrap_servers]}   ${kafka[security_protocol]} ${kafka[sasl_mechanism]}
  username  ${kafka[username]:--}
  password  ${kafka[password]:--}

S3 ($(mode_label "$S3_MODE"))
  service   s3.$ns.svc:9000           secret $ns/s3-conn
  endpoint  ${s3[endpoint]}   region ${s3[region]}   bucket ${s3[bucket]}   path_style ${s3[path_style]}
  key       ${s3[access_key]}
  secret    ${s3[secret_key]}
EOF
  observability_enabled && cat <<EOF

Grafana
  service   grafana.$NS_OBSERVABILITY.svc:80   secret $NS_OBSERVABILITY/grafana-admin
  username  $gf_user
  password  $gf_pass
EOF
  mcp_creds_text
}

# --- uninstall ---

cmd_uninstall() {
  local question
  if target_external; then
    question="Remove the releases and namespaces of the installer from context \"$KUBE_CONTEXT\" with the data of built-in storages? External storages stay."
  else
    question="Delete the minikube profile \"$MK_PROFILE\" with all data of storages and observability?"
  fi
  if [[ $ASSUME_YES != 1 ]]; then
    interactive || die "$E_USAGE" "uninstall without a terminal needs --yes"
    printf '%s Type yes: ' "$question" >&2
    local answer=""
    read -r answer || true
    [[ $answer == yes ]] || die "$E_CANCELLED" "cancelled: nothing was deleted"
  fi
  start_run_log
  trap 'on_uninstall_exit $?' EXIT
  if target_external; then
    acquire_lock
    uninstall_external
  else
    acquire_lock
    uninstall_minikube
  fi
}

on_uninstall_exit() {
  local code=$1
  ((code == 0)) || RESULT_DIAGNOSTICS=$RUN_DIR/run.log
  print_result "$code"
}

main() {
  parse_args "$@"
  setup_color
  if [[ $COMMAND == help ]]; then
    usage
    return
  fi
  # Commands that change the system end with the JSON result whatever stops them (R6).
  case $COMMAND in
    install | uninstall) trap 'print_result $?' EXIT ;;
  esac
  load_config "$ROOT" "$CONFIG_FILE"
  WORK_DIR="$ROOT/.work"
  mkdir -p "$WORK_DIR"
  case $COMMAND in
    install)
      # Products only here: status serves the rollouts of every product (lib/product.sh).
      validate_config products
      cmd_install
      ;;
    status)
      validate_config
      cmd_status
      ;;
    creds) cmd_creds ;;
    uninstall)
      validate_names
      CONFIG_MISSING=()
      validate_target
      die_if_missing
      cmd_uninstall
      ;;
  esac
}

# Sourcing without running is for unit tests (tests/unit).
if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
