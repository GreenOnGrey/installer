# Версии всех компонентов и чартов стенда (R2). Меняются только через PR.
# После изменения повторный `./hammurapi-infra.sh up` обновляет компонент.

# --- Машина ---
DOCKER_VERSION=5:29.8.1-1~debian.13~trixie
CONTAINERD_VERSION=2.3.6-1~debian.13~trixie
K8S_VERSION=v1.37.0
KUBECTL_MINOR=v1.37
KUBECTL_VERSION=1.37.1-1.1
HELM_VERSION=v3.22.0
HELM_SHA256=1e4ab49e429626cf6c6958d914248b78c9730803c2751b87627e171dc800e7bb
MINIKUBE_VERSION=v1.39.0
MINIKUBE_SHA256=b738496da01be06bbaf80c688f57ce25acd3849fbb518155f3a88e03ef555aa4

# --- Хранилища, namespace storages ---
STRIMZI_CHART_VERSION=1.2.0
KAFKA_VERSION=4.3.1
CNPG_CHART_VERSION=0.29.1
POSTGRES_IMAGE=ghcr.io/cloudnative-pg/postgresql:18.6-standard-trixie
# Объектное хранилище: SeaweedFS вместо MinIO — образы MinIO community больше
# не публикуются (риск из архитектуры, п. 17). Интерфейс s3-conn тот же.
SEAWEEDFS_CHART_VERSION=4.48.0

# --- Наблюдаемость, namespace observability ---
VM_SINGLE_CHART_VERSION=0.48.0
VL_SINGLE_CHART_VERSION=0.13.9
VMAGENT_CHART_VERSION=0.49.0
KSM_CHART_VERSION=8.6.0
NODE_EXPORTER_CHART_VERSION=4.59.0
VECTOR_CHART_VERSION=0.58.0
GRAFANA_CHART_VERSION=13.2.7
VL_PLUGIN_VERSION=0.32.0

# --- Образы проверок стенда ---
PROBE_BUSYBOX_IMAGE=busybox:1.37.0
PROBE_CURL_IMAGE=curlimages/curl:8.22.0
PROBE_KCAT_IMAGE=edenhill/kcat:1.7.1
PROBE_S3_IMAGE=amazon/aws-cli:2.37.5

# --- Публичный доступ (FTR.HMR.INFRA-0002) ---
TRAEFIK_CHART_VERSION=41.6.1
CERT_MANAGER_CHART_VERSION=v1.21.2

# --- MCP-серверы (FTR.NAB.CMN-0006) ---
# Реестр собранных образов (images/): docling-mcp, imap-mcp.
MCP_IMAGE_REGISTRY=ghcr.io/greenongrey
# Сканер образов при их сборке (images/publish.sh).
TRIVY_IMAGE=aquasec/trivy:0.75.0
DOCLING_SERVE_IMAGE=quay.io/docling-project/docling-serve-cpu:v1.37.0
# Версия пакета PyPI — она же тег образа ghcr.io/greenongrey/docling-mcp
# (images/, собирается при релизе стенда).
DOCLING_MCP_VERSION=3.3.0
# Собственный сервер IMAP только для чтения (images/imap-mcp): версия — тег образа.
IMAP_MCP_VERSION=0.1.0
MCP_SEARXNG_IMAGE=isokoliuk/mcp-searxng:2.6.0
SEARXNG_IMAGE=searxng/searxng:2026.10.11-ad46ebd7d
MCP_PROXY_IMAGE=nginxinc/nginx-unprivileged:1.31-alpine
