# Versions of all components and charts of the stand (R2). They change only through a PR.
# After a change, a repeated `./installer up` updates the component.

# --- Machine ---
# Docker Engine already on the machine is used as it is from this version (the minimum of the docker driver of minikube).
DOCKER_MIN_VERSION=20.10
DOCKER_VERSION_DEB=5:29.8.1-1~debian.13~trixie
CONTAINERD_VERSION_DEB=2.3.6-1~debian.13~trixie
DOCKER_VERSION_UBUNTU_2404=5:29.8.1-1~ubuntu.24.04~noble
CONTAINERD_VERSION_UBUNTU_2404=2.3.6-1~ubuntu.24.04~noble
DOCKER_VERSION_UBUNTU_2604=5:29.8.1-1~ubuntu.26.04~resolute
CONTAINERD_VERSION_UBUNTU_2604=2.3.6-1~ubuntu.26.04~resolute
DOCKER_VERSION_RPM_EL9=29.8.1-1.el9
CONTAINERD_VERSION_RPM_EL9=2.3.6-1.el9
DOCKER_VERSION_RPM_EL10=29.8.1-1.el10
CONTAINERD_VERSION_RPM_EL10=2.3.6-1.el10
K8S_VERSION=v1.37.0
# INSTALL_TARGET=external: below the minimum is an error, above the tested version a warning.
K8S_MIN_VERSION=1.35
K8S_MAX_TESTED=1.37
KUBECTL_BIN_VERSION=v1.37.1
KUBECTL_MINOR=${KUBECTL_BIN_VERSION%.*}
KUBECTL_SHA256=65691ff77eb6fa44c908b77a1082c9f092c3b9733b5cefabec0d1104890e21a8
HELM_VERSION=v3.22.0
HELM_SHA256=1e4ab49e429626cf6c6958d914248b78c9730803c2751b87627e171dc800e7bb
MINIKUBE_VERSION=v1.39.0
MINIKUBE_SHA256=b738496da01be06bbaf80c688f57ce25acd3849fbb518155f3a88e03ef555aa4

# --- Storages, namespace storages ---
STRIMZI_CHART_VERSION=1.2.0
KAFKA_VERSION=4.3.1
CNPG_CHART_VERSION=0.29.1
POSTGRES_IMAGE=ghcr.io/cloudnative-pg/postgresql:18.6-standard-trixie
# Object storage: SeaweedFS instead of MinIO, since MinIO community images are no longer
# published (a risk from the architecture, §17). The s3-conn interface is the same.
SEAWEEDFS_CHART_VERSION=4.48.0

# --- Observability, namespace observability ---
VM_SINGLE_CHART_VERSION=0.48.0
VL_SINGLE_CHART_VERSION=0.13.9
VMAGENT_CHART_VERSION=0.49.0
KSM_CHART_VERSION=8.6.0
NODE_EXPORTER_CHART_VERSION=4.59.0
VECTOR_CHART_VERSION=0.58.0
GRAFANA_CHART_VERSION=13.2.7
VL_PLUGIN_VERSION=0.32.0

# --- Images of the stand's checks ---
PROBE_BUSYBOX_IMAGE=busybox:1.37.0
PROBE_CURL_IMAGE=curlimages/curl:8.22.0
PROBE_KCAT_IMAGE=edenhill/kcat:1.7.1
PROBE_S3_IMAGE=amazon/aws-cli:2.37.5

# --- Public access (FTR.HMR.INFRA-0002) ---
TRAEFIK_CHART_VERSION=41.6.1
CERT_MANAGER_CHART_VERSION=v1.21.2

# --- MCP servers (FTR.NAB.CMN-0006), images and chart are in the repository mcps ---
MCP_CHART_REPO=oci://ghcr.io/greenongrey/charts/mcp-servers
MCP_CHART_VERSION=0.1.0
# Speech recognition of Nabu (FTR.NAB.CHAT-0001 R19), a CPU build.
WHISPER_ASR_IMAGE=onerahmet/openai-whisper-asr-webservice:v1.10.0

# --- Products (FTR.INFRA.INST-0001 R11, R25): only versions already running on our production ---
# The image tag of each component and the chart version in oci://ghcr.io/greenongrey/charts.
NABU_CORE_VERSION=v0.3.12
NABU_WEB_VERSION=v0.3.11
NABU_CHART_VERSION=0.3.0
# The agent Pi in the image of nabu-core (its deploy/versions.env at that tag).
NABU_PI_VERSION=1.5.2
HAMMURAPI_CORE_VERSION=v0.13.0
HAMMURAPI_WEB_VERSION=v0.11.2
HAMMURAPI_CHART_VERSION=0.3.0
