# Default values. config/local.env, environment variables and flags override them
# (in this order of priority).

# --- Cluster ---
MK_PROFILE=hammurapi
# The kubeconfig context of all cluster access. Empty means the context of the minikube profile.
KUBE_CONTEXT=
MK_CPUS=3
MK_MEMORY=12g
MK_DISK=60g
# The systemd unit hammurapi-stand: the cluster and components come back after a machine
# reboot, and the cluster stops cleanly on shutdown. false removes the unit.
STAND_AUTOSTART=true
# Image garbage collection in the node's kubelet (minikube turns it off): when image disk
# usage goes above IMAGE_GC_HIGH %, unused images are removed down to IMAGE_GC_LOW %;
# an unused image older than IMAGE_GC_MAX_AGE is removed in any case.
IMAGE_GC_HIGH=85
IMAGE_GC_LOW=80
IMAGE_GC_MAX_AGE=336h

# --- Machine minimum (R1) ---
HOST_MIN_CPUS=4
HOST_MIN_MEMORY_GB=15
HOST_MIN_DISK_GB=80

# --- Namespace ---
NS_OBSERVABILITY=observability
NS_STORAGES=storages
# State of the install: version, public access, MCP settings (lib/state.sh).
NS_STATE=installer

# --- Retention ---
VM_RETENTION=7d
VL_RETENTION=3d

# --- Volume sizes ---
VM_STORAGE=10Gi
VL_STORAGE=10Gi
KAFKA_STORAGE=10Gi
PG_STORAGE=10Gi
S3_STORAGE=10Gi
GRAFANA_STORAGE=1Gi

# --- Storage modes: internal | external ---
POSTGRES_MODE=internal
KAFKA_MODE=internal
S3_MODE=internal

# --- Names in built-in mode ---
PG_DATABASE=hammurapi
PG_USER=hammurapi
S3_BUCKET=hammurapi
S3_REGION=us-east-1

# --- Timeouts ---
HELM_TIMEOUT=10m
CHECK_TIMEOUT=5m

# --- Other ---
LOCK_FILE=/var/lock/hammurapi-infra.lock
GRAFANA_LOCAL_PORT=3000

# --- Public access (FTR.HMR.INFRA-0002) ---
# true publishes web, API and Grafana over HTTPS through MetalLB, Traefik and
# Let's Encrypt certificates; false keeps the stand as in FTR.HMR.INFRA-0001.
PUBLIC_ACCESS=false
# Empty means <external IP with dashes>.sslip.io. A real domain or DuckDNS goes here.
PUBLIC_BASE_DOMAIN=
# Empty means from an external IP detection service.
PUBLIC_IP=
# Subdomains of Hammurapi: site and API (on one domain with Nabu and Grafana).
HAMMURAPI_WEB_HOST=hammurapi
HAMMURAPI_API_HOST=hammurapi-api
# Additional subdomains in the shared certificate: Nabu on the same stand
# (FTR.NAB.CMN-0001 arch §11), site nabu. and API nabu-api.; the GreenOnGrey site
# (FTR.LND.WEB-0001) — web.
PUBLIC_EXTRA_HOSTS="nabu nabu-api web"
# Required with PUBLIC_ACCESS=true: the address for Let's Encrypt notices.
ACME_EMAIL=
# letsencrypt | letsencrypt-staging (e2e: spends no limits).
ACME_ISSUER=letsencrypt
# Empty means <minikube subnet>.200-<minikube subnet>.209.
METALLB_RANGE=
# Grafana sign-in through GitHub: the organization's OAuth app.
GRAFANA_GITHUB_CLIENT_ID=
GRAFANA_GITHUB_ORG=GreenOnGrey

# --- MCP servers (FTR.NAB.CMN-0006), namespace mcp ---
# Each server is enabled separately, and all are off by default. Set MCP_<NAME>=false to
# remove a server on the next `up`. Document conversion needs about 2 GiB of memory:
# `up` checks the budget and suggests the needed MK_MEMORY.
NS_MCP=mcp
MCP_DOCLING=false
MCP_SEARCH=false
# Read-only Yandex Mail (our own server imap-mcp from the repository mcps, Yandex OAuth).
MCP_YANDEX_MAIL=false
# Documents (FTR.NAB.CHAT-0003): docgen and doc-convert (LibreOffice and Chromium without network),
# office file preview on the Nabu site. About 1 GiB of memory requests.
MCP_DOCGEN=false
# Largest document docling-serve accepts, MB (the limit of a file argument
# is set in the Nabu catalog entry, 20 MB by default).
MCP_DOCLING_MAX_MB=25
# SearXNG search engines, comma-separated (no Google: FTR.NAB.CMN-0006, decision 3).
MCP_SEARCH_ENGINES=duckduckgo,bing,brave,wikipedia,github,stackoverflow,arxiv

# --- Speech recognition of Nabu (FTR.NAB.CHAT-0001 R19) ---
# The Whisper recognizer in the namespace nabu: voice on the site and voice messages of
# messengers. The model small on CPU takes about 1–2 GiB of memory;
# large-v3-turbo is more accurate on Russian but heavier and slower.
NABU_WHISPER=true
# Custom sandbox images of Nabu (FTR.NAB.CMN-0008 R21): an administrator
# creates profiles only from images with these prefixes (comma-separated, each
# ending with /). An operator creates registry secrets (docker-registry)
# in the sandbox namespace and lists them in NABU_SANDBOX_PULL_SECRETS.
NABU_SANDBOX_CUSTOM_IMAGES=false
NABU_SANDBOX_IMAGE_PREFIXES=
NABU_SANDBOX_PULL_SECRETS=
NABU_WHISPER_MODEL=small
