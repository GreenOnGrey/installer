# Default values. config/local.env, environment variables and flags override them
# (in this order of priority).

# --- Cluster ---
# minikube: the installer sets up the machine and the cluster. external: an existing cluster in
# KUBE_CONTEXT, and nothing changes on the machine (FTR.INFRA.INST-0001 R8, R10).
INSTALL_TARGET=minikube
MK_PROFILE=greenongrey
# The kubeconfig context of all cluster access. Empty means the context of the minikube profile.
KUBE_CONTEXT=
MK_CPUS=3
MK_MEMORY=12g
MK_DISK=60g
# The prefix of the systemd units <prefix>-stand and <prefix>-ingress-forward.
UNIT_PREFIX=greenongrey
# The systemd unit <prefix>-stand: the cluster and components come back after a machine
# reboot, and the cluster stops cleanly on shutdown. false removes the unit.
STAND_AUTOSTART=true
# Image garbage collection in the node's kubelet (minikube turns it off): when image disk
# usage goes above IMAGE_GC_HIGH %, unused images are removed down to IMAGE_GC_LOW %;
# an unused image older than IMAGE_GC_MAX_AGE is removed in any case.
IMAGE_GC_HIGH=85
IMAGE_GC_LOW=80
IMAGE_GC_MAX_AGE=336h

# --- Machine minimum (R1) ---
HOST_MIN_CPUS=4
HOST_MIN_MEMORY_GB=15
HOST_MIN_DISK_GB=80

# --- Namespace ---
NS_OBSERVABILITY=observability
NS_STORAGES=storages
# State of the install: version, public access, MCP settings (lib/state.sh).
NS_STATE=installer

# --- Retention ---
VM_RETENTION=7d
VL_RETENTION=3d

# --- Volume sizes ---
VM_STORAGE=10Gi
VL_STORAGE=10Gi
KAFKA_STORAGE=10Gi
PG_STORAGE=10Gi
S3_STORAGE=10Gi
GRAFANA_STORAGE=1Gi

# --- Storage modes: internal | external ---
POSTGRES_MODE=internal
KAFKA_MODE=internal
S3_MODE=internal

# --- Names in built-in mode ---
PG_DATABASE=hammurapi
PG_USER=hammurapi
S3_BUCKET=hammurapi
S3_BUCKET_NABU=nabu
S3_REGION=us-east-1

# --- Observability (FTR.INFRA.INST-0001 R17) ---
# false installs no VictoriaMetrics, VictoriaLogs, collectors or Grafana, and removes them if they
# were installed. The volumes of metrics and logs stay; the data of Grafana is deleted.
OBSERVABILITY=true

# --- Timeouts ---
HELM_TIMEOUT=10m
CHECK_TIMEOUT=5m

# --- Other ---
LOCK_FILE=/var/lock/installer.lock
GRAFANA_LOCAL_PORT=3000

# --- Public access (FTR.HMR.INFRA-0002) ---
# true publishes web, API and Grafana over HTTPS through MetalLB, Traefik and
# Let's Encrypt certificates; false keeps the stand as in FTR.HMR.INFRA-0001.
PUBLIC_ACCESS=false
# The certificate of the public hosts in the namespace ingress, and its secret.
CERT_NAME=greenongrey-public
# Empty means <external IP with dashes>.sslip.io, on minikube only: it shares the limits of Let's Encrypt
# with every user of sslip.io. A real domain or DuckDNS goes here.
PUBLIC_BASE_DOMAIN=
# true: on minikube, install stops with code 19 when a host of PUBLIC_BASE_DOMAIN does not resolve to
# the machine. false for a proxy in front of the machine, whose address the hosts resolve to.
PUBLIC_DNS_CHECK=true
# Empty means from an external IP detection service.
PUBLIC_IP=
# Subdomains of Hammurapi: site and API (on one domain with Nabu and Grafana).
HAMMURAPI_WEB_HOST=hammurapi
HAMMURAPI_API_HOST=hammurapi-api
# Additional subdomains in the shared certificate: Nabu on the same stand
# (FTR.NAB.CMN-0001 arch §11), site nabu. and API nabu-api. The site of GreenOnGrey
# (FTR.LND.WEB-0001) is not a product: our production adds web. in its config file, and
# bin/landing-deploy adds it to the certificate itself.
PUBLIC_EXTRA_HOSTS="nabu nabu-api"
# Required with PUBLIC_ACCESS=true: the address for Let's Encrypt notices.
ACME_EMAIL=
# letsencrypt | letsencrypt-staging (e2e: spends no limits).
ACME_ISSUER=letsencrypt
# ingress: TLS terminates on the ingress (certificates of Let's Encrypt, or of ACME_ISSUER with INGRESS_MODE=external).
# external: a load balancer in front of the install terminates TLS and sends HTTP to port 80 of the ingress;
# the installer installs no cert-manager and no certificates, and the load balancer redirects to HTTPS.
# PUBLIC_BASE_DOMAIN is required, and PUBLIC_IP is the address of the load balancer for the DNS check.
TLS_TERMINATION=ingress
# With TLS_TERMINATION=external and the built-in Traefik: the addresses or CIDRs of the load balancer,
# comma-separated. Traefik trusts their X-Forwarded-* headers only.
TLS_PROXY_CIDRS=
# internal: Traefik, cert-manager and MetalLB of the stand. external: the ingress controller and the
# ClusterIssuer of the cluster (INGRESS_CLASS and ACME_ISSUER are required), and each Ingress gets a
# certificate of its own, because controllers read secrets only from the namespace of the Ingress.
INGRESS_MODE=internal
INGRESS_CLASS=traefik
# Empty means <minikube subnet>.200-<minikube subnet>.209.
METALLB_RANGE=
# Grafana sign-in through GitHub: the organization's OAuth app.
GRAFANA_GITHUB_CLIENT_ID=
GRAFANA_GITHUB_ORG=GreenOnGrey

# --- MCP servers (FTR.NAB.CMN-0006), namespace mcp ---
# Each server is enabled separately, and all are off by default. Set MCP_<NAME>=false to
# remove a server on the next `up`. Document conversion needs about 2 GiB of memory:
# `up` checks the budget and suggests the needed MK_MEMORY.
NS_MCP=mcp
MCP_DOCLING=false
MCP_SEARCH=false
# Read-only Yandex Mail (our own server imap-mcp from the repository mcps, Yandex OAuth).
MCP_YANDEX_MAIL=false
# Documents (FTR.NAB.CHAT-0003): docgen and doc-convert (LibreOffice and Chromium without network),
# office file preview on the Nabu site. About 1 GiB of memory requests.
MCP_DOCGEN=false
# Largest document docling-serve accepts, MB (the limit of a file argument
# is set in the Nabu catalog entry, 20 MB by default).
MCP_DOCLING_MAX_MB=25
# SearXNG search engines, comma-separated (no Google: FTR.NAB.CMN-0006, decision 3).
MCP_SEARCH_ENGINES=duckduckgo,bing,brave,wikipedia,github,stackoverflow,arxiv

# --- Speech recognition of Nabu (FTR.NAB.CHAT-0001 R19) ---
# The Whisper recognizer in the namespace nabu: voice on the site and voice messages of
# messengers. The model small on CPU takes about 1–2 GiB of memory;
# large-v3-turbo is more accurate on Russian but heavier and slower.
NABU_WHISPER=true
# Custom sandbox images of Nabu (FTR.NAB.CMN-0008 R21): an administrator
# creates profiles only from images with these prefixes (comma-separated, each
# ending with /). An operator creates registry secrets (docker-registry)
# in the sandbox namespace and lists them in NABU_SANDBOX_PULL_SECRETS.
NABU_SANDBOX_CUSTOM_IMAGES=false
NABU_SANDBOX_IMAGE_PREFIXES=
NABU_SANDBOX_PULL_SECRETS=
NABU_WHISPER_MODEL=small

# --- Products (FTR.INFRA.INST-0001 R11, R13) ---
# nabu, nabu,hammurapi, hammurapi (with NABU_MODE=external), or empty: the stand without products.
# Hammurapi without an external Nabu adds Nabu. A product deployed by its own CI (no record in
# installer/installer-products) is left alone.
PRODUCTS=nabu
# internal: Nabu of this install. external: Hammurapi connects to another Nabu at NABU_URL with the
# service client NABU_CLIENT_ID and its secret NABU_CLIENT_SECRET (or _FILE); it is checked before the install.
NABU_MODE=internal
NABU_URL=
NABU_CLIENT_ID=
# Sign-in: github or oidc. The administrators get their rights at the first sign-in.
AUTH_PROVIDER=
BOOTSTRAP_ADMINS=
# github: an OAuth App per product, callback https://nabu-api.<domain>/auth/callback.
# The secret is NABU_GITHUB_CLIENT_SECRET or NABU_GITHUB_CLIENT_SECRET_FILE. GITHUB_ALLOWED_ORG
# limits sign-in to the members of an organization.
NABU_GITHUB_CLIENT_ID=
GITHUB_ALLOWED_ORG=
# oidc: one client for all products; the secret is OIDC_CLIENT_SECRET or OIDC_CLIENT_SECRET_FILE.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_PROVIDER_NAME=
DEFAULT_LANGUAGE=en
DEFAULT_TIMEZONE=UTC
# Hammurapi: the language of the specifications, ru or en — the headings it reads and writes in them
# (FTR.HMR.DEV-0003 R23). Empty: DEFAULT_LANGUAGE when it is ru or en, otherwise en.
SPEC_LANGUAGE=
# The model key of the first connection (BOOTSTRAP_LLM_API_KEY or _FILE) is optional: without it
# an administrator adds a connection in the admin area.
# Hammurapi: where its repositories live, github or gitlab.
HAMMURAPI_GIT_PROVIDER=github
# github: its GitHub App (contents and pull requests: write; events push and pull_request; installed on
# HAMMURAPI_SPEC_REPO). Its client signs users in with AUTH_PROVIDER=github. Secrets: the private key
# HAMMURAPI_GITHUB_APP_PRIVATE_KEY_FILE (a .pem) and HAMMURAPI_GITHUB_CLIENT_SECRET (or _FILE).
HAMMURAPI_GITHUB_APP_ID=
HAMMURAPI_GITHUB_CLIENT_ID=
# gitlab: the address of GitLab (empty: https://gitlab.com), its OAuth application (scopes api, read_user;
# the secret HAMMURAPI_GITLAB_CLIENT_SECRET) and the token of the bot, a Maintainer of HAMMURAPI_SPEC_REPO
# (HAMMURAPI_GITLAB_BOT_TOKEN, scope api). People sign in with AUTH_PROVIDER=oidc.
HAMMURAPI_GITLAB_URL=
HAMMURAPI_GITLAB_CLIENT_ID=
# The repository of specifications: owner/name on GitHub, group/project (subgroups too) on GitLab.
HAMMURAPI_SPEC_REPO=
