# Значения по умолчанию. Переопределяются в config/local.env, переменными
# окружения и флагами (в этом порядке приоритета).

# --- Кластер ---
MK_PROFILE=hammurapi
MK_CPUS=3
MK_MEMORY=12g
MK_DISK=60g
# systemd-юнит hammurapi-stand: кластер и компоненты поднимаются после перезагрузки
# машины, при выключении кластер останавливается штатно. false — юнит снимается.
STAND_AUTOSTART=true
# Сборка мусора образов в kubelet ноды (minikube её выключает): при заполнении диска
# образов выше IMAGE_GC_HIGH % удаляются неиспользуемые образы до IMAGE_GC_LOW %;
# неиспользуемый образ старше IMAGE_GC_MAX_AGE удаляется в любом случае.
IMAGE_GC_HIGH=85
IMAGE_GC_LOW=80
IMAGE_GC_MAX_AGE=336h

# --- Минимум машины (R1) ---
HOST_MIN_CPUS=4
HOST_MIN_MEMORY_GB=15
HOST_MIN_DISK_GB=80

# --- Namespace ---
NS_OBSERVABILITY=observability
NS_STORAGES=storages

# --- Сроки хранения ---
VM_RETENTION=7d
VL_RETENTION=3d

# --- Размеры томов ---
VM_STORAGE=10Gi
VL_STORAGE=10Gi
KAFKA_STORAGE=10Gi
PG_STORAGE=10Gi
S3_STORAGE=10Gi
GRAFANA_STORAGE=1Gi

# --- Режимы хранилищ: internal | external ---
POSTGRES_MODE=internal
KAFKA_MODE=internal
S3_MODE=internal

# --- Имена во встроенном режиме ---
PG_DATABASE=hammurapi
PG_USER=hammurapi
S3_BUCKET=hammurapi
S3_REGION=us-east-1

# --- Таймауты ---
HELM_TIMEOUT=10m
CHECK_TIMEOUT=5m

# --- Прочее ---
LOCK_FILE=/var/lock/hammurapi-infra.lock
GRAFANA_LOCAL_PORT=3000

# --- Публичный доступ (FTR.HMR.INFRA-0002) ---
# true — web, API и Grafana публикуются по HTTPS через MetalLB, Traefik и
# сертификаты Let's Encrypt; false — стенд как в FTR.HMR.INFRA-0001.
PUBLIC_ACCESS=false
# Пусто — <внешний IP с дефисами>.sslip.io. Реальный домен или DuckDNS — здесь.
PUBLIC_BASE_DOMAIN=
# Пусто — из метаданных облака или внешнего сервиса определения IP.
PUBLIC_IP=
# Поддомены Hammurapi: сайт и API (на одном домене с Nabu и Grafana).
HAMMURAPI_WEB_HOST=hammurapi
HAMMURAPI_API_HOST=hammurapi-api
# Дополнительные поддомены в общем сертификате: Nabu на том же стенде
# (FTR.NAB.CMN-0001 arch §11) — сайт nabu. и API nabu-api.; сайт GreenOnGrey
# (FTR.LND.WEB-0001) — web.
PUBLIC_EXTRA_HOSTS="nabu nabu-api web"
# Обязателен при PUBLIC_ACCESS=true: адрес для уведомлений Let's Encrypt.
ACME_EMAIL=
# letsencrypt | letsencrypt-staging (e2e: не тратит лимиты).
ACME_ISSUER=letsencrypt
# Пусто — <подсеть minikube>.200-<подсеть minikube>.209.
METALLB_RANGE=
# Вход в Grafana через GitHub: OAuth-приложение организации.
GRAFANA_GITHUB_CLIENT_ID=
GRAFANA_GITHUB_ORG=GreenOnGrey

# --- MCP-серверы (FTR.NAB.CMN-0006), namespace mcp ---
# Каждый сервер включается отдельно; по умолчанию все выключены. Выключенный
# сервер удаляется при следующем `up`. Разбор документов требует около 2 ГиБ
# памяти: `up` проверяет бюджет стенда и подсказывает нужный MK_MEMORY.
NS_MCP=mcp
MCP_DOCLING=false
MCP_SEARCH=false
# Яндекс Почта только для чтения (собственный сервер imap-mcp из репозитория mcps, OAuth Яндекса).
MCP_YANDEX_MAIL=false
# Документы (FTR.NAB.CHAT-0003): docgen и doc-convert (LibreOffice и Chromium без сети),
# предпросмотр офисных файлов на сайте Nabu. Около 1 ГиБ запросов памяти.
MCP_DOCGEN=false
# Максимальный размер документа, который принимает docling-serve, МБ (лимит
# файлового аргумента задаётся в позиции каталога Nabu, по умолчанию 20 МБ).
MCP_DOCLING_MAX_MB=25
# Поисковые системы SearXNG через запятую (без Google — FTR.NAB.CMN-0006, решение 3).
MCP_SEARCH_ENGINES=duckduckgo,bing,brave,wikipedia,github,stackoverflow,arxiv

# --- Распознавание речи Nabu (FTR.NAB.CHAT-0001 R19) ---
# Распознаватель Whisper в namespace nabu: голос на сайте и голосовые сообщения
# мессенджеров. Модель small на процессоре занимает около 1–2 ГиБ памяти;
# large-v3-turbo точнее на русском, но тяжелее и медленнее.
NABU_WHISPER=true
# Собственные образы песочниц Nabu (FTR.NAB.CMN-0008 R21): администратор
# создаёт профили только из образов с этими префиксами (через запятую, каждый
# оканчивается на /). Секреты доступа к реестрам (docker-registry) оператор
# создаёт сам в namespace песочниц и перечисляет в NABU_SANDBOX_PULL_SECRETS.
NABU_SANDBOX_CUSTOM_IMAGES=false
NABU_SANDBOX_IMAGE_PREFIXES=
NABU_SANDBOX_PULL_SECRETS=
NABU_WHISPER_MODEL=small
