# Скопируйте в config/local.env (он в .gitignore) и оставьте нужное.
# Секретные значения — только через *_FILE (путь к файлу вне репозитория) или
# одноимённые переменные окружения без _FILE. Пароль, записанный прямо в этот
# файл, останавливает скрипт с кодом 2.

# --- Ресурсы кластера ---
# MK_CPUS=3
# MK_MEMORY=12g
# MK_DISK=60g

# --- Сроки хранения ---
# VM_RETENTION=7d
# VL_RETENTION=3d

# --- Внешний Postgres (например, Cloud SQL for PostgreSQL) ---
# POSTGRES_MODE=external
# POSTGRES_HOST=10.20.0.5            # DNS-имя или IP
# POSTGRES_PORT=5432
# POSTGRES_DATABASE=hammurapi
# POSTGRES_USER=hammurapi
# POSTGRES_PASSWORD_FILE=/secure/pg-password
# POSTGRES_SSLMODE=require

# --- Внешняя Kafka (например, Managed Service for Apache Kafka) ---
# KAFKA_MODE=external
# KAFKA_BOOTSTRAP=bootstrap.hammurapi.europe-west1.managedkafka.example:9092
# KAFKA_SECURITY_PROTOCOL=SASL_SSL   # PLAINTEXT | SASL_SSL
# KAFKA_SASL_MECHANISM=PLAIN         # PLAIN | SCRAM-SHA-512 | OAUTHBEARER
# KAFKA_USERNAME=hammurapi@project.iam.gserviceaccount.com
# KAFKA_PASSWORD_FILE=/secure/kafka-password

# --- Внешнее объектное хранилище (например, Cloud Storage через S3) ---
# S3_MODE=external
# S3_ENDPOINT=https://storage.googleapis.com
# S3_REGION=europe-west1
# S3_BUCKET=hammurapi-demo
# S3_ACCESS_KEY_FILE=/secure/s3-access-key
# S3_SECRET_KEY_FILE=/secure/s3-secret-key
# S3_PATH_STYLE=false
