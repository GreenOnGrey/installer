# Copy to config/local.env (ignored by git) and keep what you need.
# Secret values go only through *_FILE (a path to a file outside the repository) or
# environment variables of the same name without _FILE. A password written directly in this
# file stops the script with code 2.

# --- Cluster resources ---
# MK_CPUS=3
# MK_MEMORY=12g
# MK_DISK=60g

# --- Retention ---
# VM_RETENTION=7d
# VL_RETENTION=3d

# --- External Postgres (such as Cloud SQL for PostgreSQL) ---
# POSTGRES_MODE=external
# POSTGRES_HOST=10.20.0.5            # DNS name or IP
# POSTGRES_PORT=5432
# POSTGRES_DATABASE=hammurapi
# POSTGRES_USER=hammurapi
# POSTGRES_PASSWORD_FILE=/secure/pg-password
# POSTGRES_SSLMODE=require

# --- External Kafka (such as Managed Service for Apache Kafka) ---
# KAFKA_MODE=external
# KAFKA_BOOTSTRAP=bootstrap.hammurapi.europe-west1.managedkafka.example:9092
# KAFKA_SECURITY_PROTOCOL=SASL_SSL   # PLAINTEXT | SASL_SSL
# KAFKA_SASL_MECHANISM=PLAIN         # PLAIN | SCRAM-SHA-512 | OAUTHBEARER
# KAFKA_USERNAME=hammurapi@project.iam.gserviceaccount.com
# KAFKA_PASSWORD_FILE=/secure/kafka-password

# --- External object storage (such as Cloud Storage through S3) ---
# S3_MODE=external
# S3_ENDPOINT=https://storage.googleapis.com
# S3_REGION=europe-west1
# S3_BUCKET=hammurapi-demo
# S3_ACCESS_KEY_FILE=/secure/s3-access-key
# S3_SECRET_KEY_FILE=/secure/s3-secret-key
# S3_PATH_STYLE=false

# --- MCP servers (FTR.NAB.CMN-0006): see the README, section MCP servers ---
# MK_MEMORY=16g              # with document conversion
# MCP_DOCLING=true
# MCP_SEARCH=true
# MCP_YANDEX_MAIL=true

# --- Ingress and observability (FTR.INFRA.INST-0001 R17) ---
# INGRESS_MODE=external       # the controller and the issuer of the cluster; also needs PUBLIC_BASE_DOMAIN
# INGRESS_CLASS=nginx
# ACME_ISSUER=letsencrypt-prod
# OBSERVABILITY=false
