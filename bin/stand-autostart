#!/usr/bin/env bash
# stand-autostart start | stop — кластер minikube стенда при загрузке и выключении
# машины. Запускается systemd-юнитом hammurapi-stand от пользователя стенда;
# юнит ставит `hammurapi-infra.sh up`.
#   start — minikube start профиля (у контейнера minikube нет политики перезапуска,
#           после перезагрузки машины он остаётся остановленным); компоненты стенда
#           поднимаются сами — их объекты и тома хранятся в профиле. Скрипт ждёт
#           готовности ноды и подов, чтобы итог был виден в journalctl.
#   stop  — minikube stop: хранилища останавливаются штатно, а не обрываются.
#   kubelet-gc — сборка мусора образов в kubelet ноды (вызывает и up).
# Если кластер уже запущен (юнит включает up), start сразу завершается; если
# профиля нет (down), оба режима ничего не делают.
set -euo pipefail

MK_PROFILE=${MK_PROFILE:-hammurapi}
DOCKER_WAIT=${DOCKER_WAIT:-120}     # секунд: docker.service активен раньше, чем отвечает API
PODS_TIMEOUT=${PODS_TIMEOUT:-15m}
IMAGE_GC_HIGH=${IMAGE_GC_HIGH:-85}
IMAGE_GC_LOW=${IMAGE_GC_LOW:-80}
IMAGE_GC_MAX_AGE=${IMAGE_GC_MAX_AGE:-336h}

log() { echo "stand-autostart: $*" >&2; }

profile_exists() {
  [[ -f "${MINIKUBE_HOME:-$HOME/.minikube}/profiles/$MK_PROFILE/config.json" ]]
}

running() {
  [[ $(minikube status -p "$MK_PROFILE" -f '{{.Host}}/{{.APIServer}}' 2>/dev/null || true) == Running/Running ]]
}

wait_docker() {
  local i
  for ((i = 0; i < DOCKER_WAIT; i += 2)); do
    docker info >/dev/null 2>&1 && return 0
    sleep 2
  done
  log "Docker не отвечает ${DOCKER_WAIT} с"
  return 1
}

start() {
  profile_exists || { log "профиля $MK_PROFILE нет — запускать нечего"; return 0; }
  wait_docker
  if running; then
    # Так юнит включает up: компоненты разворачивает он сам, ждать здесь нечего.
    log "кластер $MK_PROFILE уже запущен"
    return 0
  fi
  log "запуск кластера $MK_PROFILE"
  minikube start -p "$MK_PROFILE" --interactive=false
  kubectl --context "$MK_PROFILE" wait --for=condition=Ready node --all --timeout=5m >/dev/null
  # Без сборки мусора стенд работает, пока хватает диска, — юнит из-за неё не проваливаем.
  kubelet_gc || true
  log "нода готова, ожидание подов (до $PODS_TIMEOUT)"
  # Поды заданий (Job, CronJob) не ждём: упавший при старте под задания готовым не
  # станет никогда, а задание повторит его само. Вытесненные (Failed) — тоже.
  if kubectl --context "$MK_PROFILE" wait pods --all-namespaces --for=condition=Ready \
    --selector='!job-name' --field-selector=status.phase!=Succeeded,status.phase!=Failed \
    --timeout="$PODS_TIMEOUT" >/dev/null; then
    log "стенд поднят: все поды готовы"
  else
    # Кластер запущен — юнит не проваливаем, неготовые поды видны в журнале и в status.
    log "не все поды готовы за $PODS_TIMEOUT:"
    kubectl --context "$MK_PROFILE" get pods --all-namespaces \
      --selector='!job-name' --field-selector=status.phase!=Succeeded --no-headers 2>/dev/null |
      awk '{split($3, r, "/"); if (r[1] != r[2]) print "  " $1 "/" $2 " " $3 " " $4}' >&2 || true
  fi
}

# kubelet_gc — minikube пишет в конфигурацию kubelet imageGCHighThresholdPercent: 100,
# то есть выключает сборку мусора образов, и старые теги Nabu и Hammurapi копятся на
# диске ноды (FTR.NAB.CMN-0008). Включаем её: по заполнению диска и по возрасту
# неиспользуемого образа. minikube start переписывает файл, поэтому правка — после
# каждого запуска; kubelet перезапускается, только если файл изменился (поды при этом
# работают дальше).
# shellcheck disable=SC2016 # скрипт выполняет shell ноды: $f и $1…$3 — его переменные
kubelet_gc() {
  local script
  script='f=/var/lib/kubelet/config.yaml; cp "$f" "$f.orig";'
  script+=' set_key() { if grep -q "^$1:" "$f"; then sed -i "s|^$1:.*|$1: $2|" "$f"; else echo "$1: $2" >>"$f"; fi; };'
  script+=' set_key imageGCHighThresholdPercent "$1"; set_key imageGCLowThresholdPercent "$2"; set_key imageMaximumGCAge "$3";'
  script+=' if cmp -s "$f" "$f.orig"; then echo unchanged; else systemctl restart kubelet && echo changed; fi; rm -f "$f.orig"'
  local out
  out=$(minikube ssh -p "$MK_PROFILE" -- sudo sh -c "$(printf %q "$script")" kubelet-gc \
    "$IMAGE_GC_HIGH" "$IMAGE_GC_LOW" "$IMAGE_GC_MAX_AGE" 2>&1) || true
  case $out in
    *unchanged*) ;;
    *changed*)
      log "сборка мусора образов: диск $IMAGE_GC_HIGH→$IMAGE_GC_LOW %, неиспользуемые старше $IMAGE_GC_MAX_AGE; kubelet перезапущен" ;;
    *)
      log "сборку мусора образов настроить не удалось: $out"
      return 1
      ;;
  esac
}

stop() {
  profile_exists || return 0
  running || { log "кластер $MK_PROFILE не запущен"; return 0; }
  log "остановка кластера $MK_PROFILE"
  minikube stop -p "$MK_PROFILE"
}

case ${1:-} in
  start) start ;;
  stop) stop ;;
  kubelet-gc) kubelet_gc ;;
  *)
    echo "использование: stand-autostart start | stop | kubelet-gc" >&2
    exit 2
    ;;
esac
