#!/usr/bin/env bash
# stand-autostart start | stop — the minikube cluster of the stand on machine boot and
# shutdown. Run by the systemd unit <prefix>-stand as the user of the stand;
# `installer up` installs the unit.
#   start — minikube start of the profile (the minikube container has no restart policy,
#           so it stays stopped after a reboot); components of the stand come back on
#           their own, since their objects and volumes live in the profile. The script waits
#           for the node and pods so the outcome shows in journalctl.
#   stop  — minikube stop: storages stop cleanly instead of being cut off.
#   kubelet-gc — image garbage collection in the node's kubelet (up calls it too).
# If the cluster already runs (up enables the unit), start ends at once; if
# the profile is gone (down), both modes do nothing.
set -euo pipefail

MK_PROFILE=${MK_PROFILE:-greenongrey}
DOCKER_WAIT=${DOCKER_WAIT:-120}     # seconds: docker.service is active before its API answers
PODS_TIMEOUT=${PODS_TIMEOUT:-15m}
IMAGE_GC_HIGH=${IMAGE_GC_HIGH:-85}
IMAGE_GC_LOW=${IMAGE_GC_LOW:-80}
IMAGE_GC_MAX_AGE=${IMAGE_GC_MAX_AGE:-336h}

log() { echo "stand-autostart: $*" >&2; }

profile_exists() {
  [[ -f "${MINIKUBE_HOME:-$HOME/.minikube}/profiles/$MK_PROFILE/config.json" ]]
}

running() {
  [[ $(minikube status -p "$MK_PROFILE" -f '{{.Host}}/{{.APIServer}}' 2>/dev/null || true) == Running/Running ]]
}

wait_docker() {
  local i
  for ((i = 0; i < DOCKER_WAIT; i += 2)); do
    docker info >/dev/null 2>&1 && return 0
    sleep 2
  done
  log "Docker has not answered for ${DOCKER_WAIT} s"
  return 1
}

start() {
  profile_exists || { log "no profile $MK_PROFILE, nothing to start"; return 0; }
  wait_docker
  if running; then
    # This is how up enables the unit: up deploys components itself, nothing to wait for.
    log "cluster $MK_PROFILE is already running"
    return 0
  fi
  log "starting cluster $MK_PROFILE"
  minikube start -p "$MK_PROFILE" --interactive=false
  kubectl --context "$MK_PROFILE" wait --for=condition=Ready node --all --timeout=5m >/dev/null
  # Without garbage collection the stand works while the disk lasts, so the unit does not fail.
  kubelet_gc || true
  log "node is ready, waiting for pods (up to $PODS_TIMEOUT)"
  # Pods of Job and CronJob are not awaited: a job pod that failed at start never becomes
  # ready, and the job retries it itself. Evicted (Failed) pods neither.
  if kubectl --context "$MK_PROFILE" wait pods --all-namespaces --for=condition=Ready \
    --selector='!job-name' --field-selector=status.phase!=Succeeded,status.phase!=Failed \
    --timeout="$PODS_TIMEOUT" >/dev/null; then
    log "the stand is up: all pods are ready"
  else
    # The cluster runs, so the unit does not fail: unready pods show in the log and in status.
    log "not all pods are ready after $PODS_TIMEOUT:"
    kubectl --context "$MK_PROFILE" get pods --all-namespaces \
      --selector='!job-name' --field-selector=status.phase!=Succeeded --no-headers 2>/dev/null |
      awk '{split($3, r, "/"); if (r[1] != r[2]) print "  " $1 "/" $2 " " $3 " " $4}' >&2 || true
  fi
}

# kubelet_gc — minikube writes imageGCHighThresholdPercent: 100 to the kubelet config,
# which turns image garbage collection off, and old tags of Nabu and Hammurapi pile up on
# the node's disk (FTR.NAB.CMN-0008). This turns it on: by disk usage and by the age of an
# unused image. minikube start rewrites the file, so the edit follows every
# start; kubelet restarts only if the file changed (pods keep
# running).
# shellcheck disable=SC2016 # the script runs in the node's shell: $f and $1…$3 are its variables
kubelet_gc() {
  local script
  script='f=/var/lib/kubelet/config.yaml; cp "$f" "$f.orig";'
  script+=' set_key() { if grep -q "^$1:" "$f"; then sed -i "s|^$1:.*|$1: $2|" "$f"; else echo "$1: $2" >>"$f"; fi; };'
  script+=' set_key imageGCHighThresholdPercent "$1"; set_key imageGCLowThresholdPercent "$2"; set_key imageMaximumGCAge "$3";'
  script+=' if cmp -s "$f" "$f.orig"; then echo unchanged; else systemctl restart kubelet && echo changed; fi; rm -f "$f.orig"'
  local out
  out=$(minikube ssh -p "$MK_PROFILE" -- sudo sh -c "$(printf %q "$script")" kubelet-gc \
    "$IMAGE_GC_HIGH" "$IMAGE_GC_LOW" "$IMAGE_GC_MAX_AGE" 2>&1) || true
  case $out in
    *unchanged*) ;;
    *changed*)
      log "image garbage collection: disk $IMAGE_GC_HIGH→$IMAGE_GC_LOW%, unused images older than $IMAGE_GC_MAX_AGE; kubelet restarted" ;;
    *)
      log "failed to configure image garbage collection: $out"
      return 1
      ;;
  esac
}

stop() {
  profile_exists || return 0
  running || { log "cluster $MK_PROFILE is not running"; return 0; }
  log "stopping cluster $MK_PROFILE"
  minikube stop -p "$MK_PROFILE"
}

case ${1:-} in
  start) start ;;
  stop) stop ;;
  kubelet-gc) kubelet_gc ;;
  *)
    echo "usage: stand-autostart start | stop | kubelet-gc" >&2
    exit 2
    ;;
esac
