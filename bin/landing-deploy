#!/usr/bin/env bash
# landing-deploy <tag> <chart_version>
#
# Rolls out the GreenOnGrey site on the Hammurapi stand (FTR.LND.WEB-0001 arch §7, tech §9):
# the same minikube, its own namespace landing, host web.<stand domain> in the shared
# Traefik certificate. The site has no storages, database or secrets: it is nginx with
# static pages. Run by the workflow release.yml of the repository landing over
# SSH on the machine, like hammurapi-deploy and nabu-deploy: the scripts are in
# /opt/installer/current/bin and take stand functions from lib/ of the same release.
#   stdin   JSON { image, ghcrPullToken, domain }; read into memory, it never reaches disk,
#           command arguments or logs
#   stdout  log; the last line is the JSON result
#           { status, component, tag, chartVersion, revision, firstInstall, publicBaseDomain,
#             webUrl, standUrl, domain, … }
#
# domain (optional) — the site's own domain, such as greenongrey.tech: the site
# opens at https://<domain>, www.<domain> redirects to it, and both names get a
# separate certificate; the address web.<stand domain> stays. Before any change in
# the cluster, both names are checked to point to the stand's address.
#
# Codes: 2 arguments; 17 a rollout is running; 20 the stand is not ready or a host could not
# join the certificate; 22 namespace; 23 secrets and configuration; 25 Helm release;
# 27 pod readiness; 28 DNS of the own domain; 29 certificate of the own domain.
set -euo pipefail

ROOT=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
# shellcheck source=../lib/common.sh
source "$ROOT/lib/common.sh"

readonly E_STAND=20 E_NS=22 E_SECRETS=23 E_HELM=25 E_READY=27 E_DNS=28 E_CERT=29
readonly COMPONENT=landing
NS=${LANDING_NAMESPACE:-landing}
CHART_REPO=${CHART_REPO:-oci://ghcr.io/greenongrey/charts}
REGISTRY=${REGISTRY:-ghcr.io}
DEPLOY_LOCK_DIR=${DEPLOY_LOCK_DIR:-/var/lock}
STATUS_CMD=${STATUS_CMD:-"$ROOT/installer"}
NS_INGRESS=${NS_INGRESS:-ingress}
WEB_HOST=${LANDING_WEB_HOST:-web}

TAG="" CHART_VERSION=""
FIRST_INSTALL=false BASE_DOMAIN="" REVISION="" DIAG="" PAYLOAD="" HELM_REG="" FAIL_MSG=""
DOMAIN="" PUBLIC_IP_STAND="" ISSUER=""

usage() {
  echo "usage: landing-deploy <vX.Y.Z> <chart version>" >&2
  exit "$E_USAGE"
}

fail() {
  FAIL_MSG=$2
  die "$1" "$2"
}

result() {
  local code=$1 status=success
  ((code == 0)) || status=failure
  [[ -n $HELM_REG ]] && rm -f "$HELM_REG"
  jq -cn --arg s "$status" --arg c "$COMPONENT" --arg t "$TAG" --arg r "$REVISION" \
    --argjson first "$FIRST_INSTALL" --arg d "$BASE_DOMAIN" --arg chart "$CHART_VERSION" \
    --argjson code "$code" --arg e "$FAIL_MSG" --arg diag "$DIAG" --arg web "$WEB_HOST" --arg own "$DOMAIN" \
    '{status: $s, component: $c, tag: $t, chartVersion: $chart, revision: $r, firstInstall: $first,
      publicBaseDomain: $d, code: $code}
     + (if $d != "" then {standUrl: "https://\($web).\($d)"} else {} end)
     + (if $own != "" then {domain: $own, webUrl: "https://\($own)"}
        elif $d != "" then {webUrl: "https://\($web).\($d)"} else {} end)
     + (if $s == "failure" then {error: (if $e == "" then "code \($code)" else $e end), diagnostics: $diag} else {} end)'
}

parse_args() {
  (($# == 2)) || usage
  TAG=$1 CHART_VERSION=$2
  [[ $TAG =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || fail "$E_USAGE" "tag '$TAG' is not in the format vX.Y.Z"
  [[ $CHART_VERSION =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || fail "$E_USAGE" "chart version '$CHART_VERSION' is not in the format X.Y.Z"
}

acquire_deploy_lock() {
  exec 8>>"$DEPLOY_LOCK_DIR/landing-deploy.lock"
  flock -n 8 || fail "$E_LOCKED" "a rollout of $COMPONENT is already running on this machine"
}

# payload <jq path> — a value from the stdin JSON (jq reads a pipe, not arguments).
payload() { printf '%s' "$PAYLOAD" | jq -r "$1 // empty"; }

read_payload() {
  if [[ -t 0 ]]; then
    PAYLOAD='{}'
  else
    PAYLOAD=$(cat)
    [[ -n $PAYLOAD ]] || PAYLOAD='{}'
  fi
  printf '%s' "$PAYLOAD" | jq -e 'type == "object"' >/dev/null 2>&1 || fail "$E_SECRETS" "stdin: a JSON object is expected"
  DOMAIN=$(payload .domain)
  if [[ -n $DOMAIN && ! $DOMAIN =~ ^([a-z0-9]([a-z0-9-]*[a-z0-9])?\.)+[a-z]{2,}$ ]]; then
    local bad=$DOMAIN
    DOMAIN=""
    fail "$E_SECRETS" "domain: invalid name '$bad'"
  fi
}

apply_json() { kc apply -f - >/dev/null; }

# --- 1. The stand ---

check_stand() {
  step stand
  local st cfg=()
  [[ -f ${INSTALLER_CONFIG:-} ]] && cfg=(--config "$INSTALLER_CONFIG")
  st=$(INSTALLER_STAND_ONLY=1 bash "$STATUS_CMD" status --json --no-color "${cfg[@]}" 2>/dev/null) || true
  jq -e . >/dev/null 2>&1 <<<"$st" || fail "$E_STAND" "the stand does not answer: installer status --json"
  if [[ $(jq -r '.ok' <<<"$st") != true ]]; then
    fail "$E_STAND" "the stand is not ready: $(jq -r '[.checks[] | select(.ok | not) | "\(.name): \(.message)"] | join("; ")' <<<"$st")"
  fi
  [[ $(jq -r '.public.enabled' <<<"$st") == true ]] || fail "$E_STAND" "public access of the stand is off (PUBLIC_ACCESS=true)"
  ingress_from_status "$st"
  # The chart redirects www. through a Middleware of Traefik.
  if ingress_external; then fail "$E_STAND" "the site needs Traefik of the stand: INGRESS_MODE=internal"; fi
  BASE_DOMAIN=$(jq -r '.public.baseDomain // empty' <<<"$st")
  [[ -n $BASE_DOMAIN ]] || fail "$E_STAND" "the stand did not report a base domain"
  PUBLIC_IP_STAND=$(jq -r '.public.publicIp // empty' <<<"$st")
  ISSUER=$(jq -r '.public.issuer // "letsencrypt"' <<<"$st")
  ok "the stand is ready, domain $BASE_DOMAIN"
  hm status "$COMPONENT" -n "$NS" >/dev/null 2>&1 || FIRST_INSTALL=true
}

# --- 2. Namespace and registry access ---

ensure_namespace() {
  step namespace
  kc create namespace "$NS" --dry-run=client -o yaml | kc label --local -f - "app.kubernetes.io/part-of=landing" -o yaml |
    apply_stdin || fail "$E_NS" "failed to create namespace $NS"
}

ghcr_pull() {
  local token
  token=$(payload .ghcrPullToken)
  if [[ -z $token ]]; then
    kc -n "$NS" get secret ghcr-pull >/dev/null 2>&1 || fail "$E_SECRETS" "neither ghcrPullToken nor the secret ghcr-pull exists"
    return
  fi
  printf '%s' "$token" | jq -Rc --arg ns "$NS" --arg reg "$REGISTRY" '
    {auths: {($reg): {username: "landing", password: ., auth: ("landing:" + . | @base64)}}} as $cfg
    | {apiVersion: "v1", kind: "Secret", type: "kubernetes.io/dockerconfigjson",
       metadata: {name: "ghcr-pull", namespace: $ns, labels: {"app.kubernetes.io/managed-by": "landing-deploy"}},
       data: {".dockerconfigjson": ($cfg | tojson | @base64)}}' | apply_json ||
    fail "$E_SECRETS" "failed to write ghcr-pull to $NS"
}

# --- 3. Certificate ---

# ensure_certificate — web. in the shared Traefik certificate. The stand adds it
# itself (PUBLIC_EXTRA_HOSTS), but a site rollout must not depend on release order.
ensure_certificate() {
  step certificate
  local names want=$WEB_HOST.$BASE_DOMAIN
  names=$(kc -n "$NS_INGRESS" get certificate "$CERT_NAME" -o json 2>/dev/null | jq -r '.spec.dnsNames[]?') ||
    fail "$E_STAND" "certificate $NS_INGRESS/$CERT_NAME does not exist"
  if grep -qxF "$want" <<<"$names"; then
    ok "the certificate includes $want"
    return
  fi
  jq -cn --arg h "$want" '[{op: "add", path: "/spec/dnsNames/-", value: $h}]' |
    kc -n "$NS_INGRESS" patch certificate "$CERT_NAME" --type json --patch-file /dev/stdin >/dev/null ||
    fail "$E_STAND" "failed to add $want to the certificate"
  log "certificate: added $want, waiting for issuance"
  kc -n "$NS_INGRESS" wait "certificate/$CERT_NAME" --for=condition=Ready --timeout=5m >/dev/null 2>&1 ||
    warn "the certificate is not issued yet; check that *.$BASE_DOMAIN points to the machine"
}

# check_domain_dns — both names of the own domain point to the stand's address.
# Otherwise Let's Encrypt issues no certificate and the site does not open by domain:
# the rollout stops before any change in the cluster.
check_domain_dns() {
  [[ -n $DOMAIN ]] || return 0
  step dns
  [[ -n $PUBLIC_IP_STAND ]] || fail "$E_STAND" "the stand did not report a public address"
  local name ips
  for name in "$DOMAIN" "www.$DOMAIN"; do
    ips=$(getent ahostsv4 "$name" 2>/dev/null | awk '{print $1}' | sort -u | tr '\n' ' ')
    ips=${ips% }
    [[ $ips == "$PUBLIC_IP_STAND" ]] ||
      fail "$E_DNS" "$name points to '${ips:-no record}', but one A record for $PUBLIC_IP_STAND is required"
  done
  ok "$DOMAIN and www.$DOMAIN point to $PUBLIC_IP_STAND"
}

# --- 4. Helm ---

helm_login() {
  local token
  token=$(payload .ghcrPullToken)
  [[ -n $token ]] || token=$(kc -n "$NS" get secret ghcr-pull -o jsonpath='{.data.\.dockerconfigjson}' 2>/dev/null |
    base64 -d | jq -r --arg r "$REGISTRY" '.auths[$r].password // empty')
  [[ -n $token ]] || fail "$E_HELM" "no registry read token for the chart"
  HELM_REG=$(mktemp -p /dev/shm landing-helm-XXXXXX.json 2>/dev/null || mktemp)
  export HELM_REGISTRY_CONFIG=$HELM_REG
  printf '%s' "$token" | helm registry login "$REGISTRY" --username landing --password-stdin >/dev/null 2>&1 ||
    fail "$E_HELM" "failed to sign in to $REGISTRY"
}

diagnostics() {
  local dir ts logs
  ts=$(date -u +%Y%m%dT%H%M%SZ)
  dir=$(mktemp -d)
  kc -n "$NS" get events --sort-by=.lastTimestamp >"$dir/events.txt" 2>&1 || true
  kc -n "$NS" get pods -o wide >"$dir/pods.txt" 2>&1 || true
  kc -n "$NS" describe pods >"$dir/describe-pods.txt" 2>&1 || true
  hm history "$COMPONENT" -n "$NS" >"$dir/helm-history.txt" 2>&1 || true
  kc -n "$NS" logs deploy/web --all-containers --tail=300 >"$dir/web.log" 2>&1 || true
  kc -n "$NS" describe certificate,certificaterequest,order,challenge >"$dir/certificate.txt" 2>&1 || true
  logs=${DEPLOY_LOGS:-/opt/installer/logs}
  [[ -d $logs && -w $logs ]] || logs=$ROOT/logs
  mkdir -p "$logs"
  DIAG=$logs/deploy-$COMPONENT-$ts.tar.gz
  tar -czf "$DIAG" -C "$dir" . && rm -rf "$dir"
}

helm_deploy() {
  step helm
  helm_login
  local image args
  image=$(payload .image)
  args=(upgrade --install "$COMPONENT" "$CHART_REPO/$COMPONENT" --version "$CHART_VERSION"
    -n "$NS" --set-string "image.tag=$TAG" --set-string "publicBaseDomain=$BASE_DOMAIN"
    --set-string "hosts.web=$WEB_HOST" --set-string "domain=$DOMAIN" --set-string "issuer=$ISSUER"
    --atomic --wait --timeout "${HELM_TIMEOUT:-10m}")
  [[ -n $image ]] && args+=(--set-string "image.repository=$image")
  log "helm upgrade --install $COMPONENT $TAG (chart $CHART_VERSION)"
  if ! hm "${args[@]}" >&2; then
    diagnostics
    fail "$E_HELM" "release $COMPONENT $TAG was not deployed, Helm restored the previous revision; diagnostics: $DIAG"
  fi
  REVISION=$(hm status "$COMPONENT" -n "$NS" -o json 2>/dev/null | jq -r '.version // empty')
}

wait_ready() {
  step ready
  if ! kc -n "$NS" rollout status deploy/web --timeout=5m >/dev/null 2>&1; then
    diagnostics
    fail "$E_READY" "web is not ready; diagnostics: $DIAG"
  fi
  ok "$COMPONENT $TAG is ready (revision $REVISION)"
}

# wait_domain_certificate — the certificate of the own domain is issued. The site
# already works at the stand's address; by domain it opens without a warning only
# with this certificate.
wait_domain_certificate() {
  [[ -n $DOMAIN ]] || return 0
  step domain
  if ! kc -n "$NS" wait certificate/landing-domain --for=condition=Ready --timeout=5m >/dev/null 2>&1; then
    diagnostics
    fail "$E_CERT" "the certificate for $DOMAIN was not issued in 5 minutes; diagnostics: $DIAG"
  fi
  ok "the certificate for $DOMAIN and www.$DOMAIN is issued"
}

on_exit() {
  local rc=$?
  result "$rc"
  exit "$rc"
}

main() {
  trap on_exit EXIT
  # shellcheck disable=SC2034 # setup_color of the stand reads COLOR
  COLOR=0
  setup_color
  parse_args "$@"
  INSTALLER_CONFIG=$(installer_config)
  load_config "$ROOT" "$INSTALLER_CONFIG"
  acquire_deploy_lock
  read_payload
  check_stand
  check_domain_dns
  ensure_namespace
  ghcr_pull
  ensure_certificate
  helm_deploy
  wait_ready
  wait_domain_certificate
}

main "$@"
