#!/usr/bin/env bash
# ingress-forward apply | remove | status — forwards TCP 80/443 of the machine's external
# interface to the Traefik address given by MetalLB in the minikube Docker network
# (FTR.HMR.INFRA-0002, R17). Run by the systemd unit <prefix>-ingress-forward
# after docker.service and by `up`.
#   - DNAT in nat/PREROUTING: <external interface>:80,443 → LB_IP;
#   - an allow rule in DOCKER-USER: Docker leaves this chain alone.
# No SNAT: answers from the Docker network go through the machine, conntrack returns
# them to the client, and the client address is preserved. All rules carry a comment and
# are removed before adding, so a Docker restart leaves no duplicates.
set -euo pipefail

PORTS=80,443
FORWARD_STATE=${FORWARD_STATE:-/var/lib/installer}
# The prefix is in the state of `up`: the comment is the same in the unit and in a manual run.
COMMENT=$(cat "$FORWARD_STATE/unit-prefix" 2>/dev/null || echo greenongrey)-ingress
IPTABLES=${IPTABLES:-iptables}

log() { echo "ingress-forward: $*" >&2; }

# lb_ip — LB_IP from the environment or the cache `up` writes: at boot the
# cluster is not up yet, but the MetalLB address stays with Traefik.
lb_ip() {
  local ip=${LB_IP:-}
  [[ -z $ip && -r $FORWARD_STATE/lb-ip ]] && ip=$(tr -d '[:space:]' <"$FORWARD_STATE/lb-ip")
  [[ $ip =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 1
  echo "$ip"
}

ext_if() {
  local dev=${EXT_IF:-}
  [[ -n $dev ]] || dev=$(ip -o -4 route show to default | awk '{print $5; exit}')
  [[ -n $dev ]] || return 1
  echo "$dev"
}

# remove_rules — removes all commented rules from nat/PREROUTING and DOCKER-USER.
remove_rules() {
  local table chain rule spec args
  for spec in "nat PREROUTING" "filter DOCKER-USER"; do
    read -r table chain <<<"$spec"
    # || true: there may be no rules yet (first apply), which is no error under pipefail.
    { "$IPTABLES" -t "$table" -S "$chain" 2>/dev/null || true; } | { grep -F -- "--comment $COMMENT" || true; } | while IFS= read -r rule; do
      # -A CHAIN … from iptables -S → -D CHAIN …; our rules have no spaces in values.
      read -ra args <<<"${rule#-A }"
      "$IPTABLES" -t "$table" -D "${args[@]}"
    done
  done
}

apply_rules() {
  local ip dev
  ip=$(lb_ip) || { log "no Traefik address (LB_IP or $FORWARD_STATE/lb-ip)"; exit 1; }
  dev=$(ext_if) || { log "no external interface found (default route)"; exit 1; }
  remove_rules
  "$IPTABLES" -t nat -A PREROUTING -i "$dev" -p tcp -m multiport --dports "$PORTS" \
    -m comment --comment "$COMMENT" -j DNAT --to-destination "$ip"
  # Docker creates DOCKER-USER; if it is missing we create it, and Docker keeps it.
  "$IPTABLES" -t filter -N DOCKER-USER 2>/dev/null || true
  "$IPTABLES" -t filter -I DOCKER-USER -d "$ip" -p tcp -m multiport --dports "$PORTS" \
    -m comment --comment "$COMMENT" -j ACCEPT
  log "$dev:{$PORTS} → $ip"
}

case ${1:-} in
  apply) apply_rules ;;
  remove) remove_rules ;;
  status)
    "$IPTABLES" -t nat -S PREROUTING | grep -F -- "--comment $COMMENT" || true
    "$IPTABLES" -t filter -S DOCKER-USER 2>/dev/null | grep -F -- "--comment $COMMENT" || true
    ;;
  *)
    echo "usage: ingress-forward apply | remove | status" >&2
    exit 2
    ;;
esac
