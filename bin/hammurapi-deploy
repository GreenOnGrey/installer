#!/usr/bin/env bash
# hammurapi-deploy <component> <tag> <chart_version> [--allow-key-rotation]
#
# Rolls out Hammurapi on the stand (FTR.HMR.INFRA-0002, tech §3). Run by the
# reusable workflow deploy-component.yml over SSH on the machine of the stand.
#   component       hammurapi-core | hammurapi-web
#   stdin           JSON with configuration and secrets (§3.1); read into memory,
#                   it never reaches disk, command arguments or logs
#   stdout/stderr   log; the last line of stdout is the JSON result
#                   { status, component, tag, revision, firstInstall, publicBaseDomain, … }
#
# Codes: 17 a rollout of the component is running; 20 the stand is not ready or has no public
# access; 21 web without core; 22 namespace; 23 secrets and configuration; 24 the token
# encryption key changed; 25 Helm release (--atomic restored the previous revision);
# 26 GitHub App; 27 pod readiness.
set -euo pipefail

ROOT=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
# shellcheck source=../lib/common.sh
source "$ROOT/lib/common.sh"

readonly E_STAND=20 E_NO_CORE=21 E_NS=22 E_SECRETS=23 E_KEY=24 E_HELM=25 E_APP=26 E_READY=27
NS=${HAMMURAPI_NAMESPACE:-hammurapi}
CHART_REPO=${CHART_REPO:-oci://ghcr.io/greenongrey/charts}
REGISTRY=${REGISTRY:-ghcr.io}
GITHUB_API=${GITHUB_API:-https://api.github.com}
DEPLOY_LOCK_DIR=${DEPLOY_LOCK_DIR:-/var/lock}
STATUS_CMD=${STATUS_CMD:-"$ROOT/installer"}

COMPONENT="" TAG="" CHART_VERSION="" ALLOW_KEY_ROTATION=0
FIRST_INSTALL=false BASE_DOMAIN="" REVISION="" DIAG="" PAYLOAD="" HELM_REG=""
FAIL_MSG=""

usage() {
  echo "usage: hammurapi-deploy <hammurapi-core|hammurapi-web> <vX.Y.Z> <chart version> [--allow-key-rotation]" >&2
  exit "$E_USAGE"
}

# fail <code> <message> — keeps the reason for the result and exits.
fail() {
  FAIL_MSG=$2
  die "$1" "$2"
}

# result — the result as the last line of stdout, on success and on failure.
result() {
  local code=$1 status=success
  ((code == 0)) || status=failure
  [[ -n $HELM_REG ]] && rm -f "$HELM_REG"
  jq -cn --arg s "$status" --arg c "$COMPONENT" --arg t "$TAG" --arg r "$REVISION" \
    --argjson first "$FIRST_INSTALL" --arg d "$BASE_DOMAIN" --arg chart "$CHART_VERSION" \
    --argjson code "$code" --arg e "$FAIL_MSG" --arg diag "$DIAG" \
    --arg web "${HAMMURAPI_WEB_HOST:-hammurapi}" --arg api "${HAMMURAPI_API_HOST:-hammurapi-api}" \
    '{status: $s, component: $c, tag: $t, chartVersion: $chart, revision: $r, firstInstall: $first,
      publicBaseDomain: $d, code: $code}
     + (if $d != "" then {webUrl: "https://\($web).\($d)", apiUrl: "https://\($api).\($d)"} else {} end)
     + (if $s == "failure" then {error: (if $e == "" then "code \($code)" else $e end), diagnostics: $diag} else {} end)'
}

parse_args() {
  (($# >= 3)) || usage
  COMPONENT=$1 TAG=$2 CHART_VERSION=$3
  shift 3
  while (($#)); do
    case $1 in
      --allow-key-rotation) ALLOW_KEY_ROTATION=1 ;;
      *) usage ;;
    esac
    shift
  done
  case $COMPONENT in hammurapi-core | hammurapi-web) ;; *) usage ;; esac
  [[ $TAG =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || fail "$E_USAGE" "tag '$TAG' is not in the format vX.Y.Z"
  [[ $CHART_VERSION =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || fail "$E_USAGE" "chart version '$CHART_VERSION' is not in the format X.Y.Z"
}

acquire_deploy_lock() {
  exec 8>>"$DEPLOY_LOCK_DIR/hammurapi-deploy-$COMPONENT.lock"
  flock -n 8 || fail "$E_LOCKED" "a rollout of $COMPONENT is already running on this machine"
}

# payload <jq path> — a value from the stdin JSON (jq reads a pipe, not arguments).
payload() { printf '%s' "$PAYLOAD" | jq -r "$1 // empty"; }

read_payload() {
  if [[ -t 0 ]]; then
    PAYLOAD='{}'
  else
    PAYLOAD=$(cat)
    [[ -n $PAYLOAD ]] || PAYLOAD='{}'
  fi
  printf '%s' "$PAYLOAD" | jq -e 'type == "object"' >/dev/null 2>&1 || fail "$E_SECRETS" "stdin: a JSON object is expected"
}

# --- 1. The stand ---

check_stand() {
  step stand
  local st cfg=()
  # On prod the configuration is outside the unpacked release (/opt/installer/local.env).
  [[ -f ${INSTALLER_CONFIG:-} ]] && cfg=(--config "$INSTALLER_CONFIG")
  st=$(INSTALLER_STAND_ONLY=1 bash "$STATUS_CMD" status --json --no-color "${cfg[@]}" 2>/dev/null) || true
  if ! jq -e . >/dev/null 2>&1 <<<"$st"; then
    fail "$E_STAND" "the stand does not answer: installer status --json"
  fi
  if [[ $(jq -r '.ok' <<<"$st") != true ]]; then
    fail "$E_STAND" "the stand is not ready: $(jq -r '[.checks[] | select(.ok | not) | "\(.name): \(.message)"] | join("; ")' <<<"$st")"
  fi
  if [[ $(jq -r '.public.enabled' <<<"$st") != true ]]; then
    fail "$E_STAND" "public access of the stand is off: set PUBLIC_ACCESS=true in the installer configuration and run up"
  fi
  ingress_from_status "$st"
  BASE_DOMAIN=$(jq -r '.public.baseDomain // empty' <<<"$st")
  [[ -n $BASE_DOMAIN ]] || fail "$E_STAND" "the stand did not report a base domain"
  ok "the stand is ready, domain $BASE_DOMAIN"
}

# --- 2. Order of components ---

check_order() {
  if hm status hammurapi-core -n "$NS" >/dev/null 2>&1; then
    [[ $COMPONENT == hammurapi-core ]] && FIRST_INSTALL=false
  else
    [[ $COMPONENT == hammurapi-web ]] && fail "$E_NO_CORE" "roll out hammurapi-core first"
    FIRST_INSTALL=true
  fi
  if [[ $COMPONENT == hammurapi-web ]] && ! hm status hammurapi-web -n "$NS" >/dev/null 2>&1; then
    FIRST_INSTALL=true
  fi
}

# --- 3. Namespace ---

ensure_namespaces() {
  step namespaces
  # The label by which uninstall of the installer finds the namespace.
  kc create namespace "$NS" --dry-run=client -o json | jq '.metadata.labels["app.kubernetes.io/part-of"] = "hammurapi"' |
    apply_stdin || fail "$E_NS" "failed to create namespace $NS"
}

# --- 4. Secrets and configuration ---

# apply_json — a JSON manifest from stdin to kubectl apply: values stay out of arguments.
apply_json() { kc apply -f - >/dev/null; }

ghcr_pull() {
  local token
  token=$(payload .ghcrPullToken)
  # The images are public (FTR.INFRA.INST-0001 arch §1): without a token they pull anonymously.
  [[ -n $token ]] || return 0
  printf '%s' "$token" | jq -Rc --arg ns "$NS" --arg reg "$REGISTRY" '
    {auths: {($reg): {username: "hammurapi", password: ., auth: ("hammurapi:" + . | @base64)}}} as $cfg
    | {apiVersion: "v1", kind: "Secret", type: "kubernetes.io/dockerconfigjson",
       metadata: {name: "ghcr-pull", namespace: $ns, labels: {"app.kubernetes.io/managed-by": "hammurapi-deploy"}},
       data: {".dockerconfigjson": ($cfg | tojson | @base64)}}' | apply_json ||
    fail "$E_SECRETS" "failed to write ghcr-pull to $NS"
}

check_key_fingerprint() {
  local fp saved
  fp=$(payload .secrets.TOKEN_ENCRYPTION_KEY | sha256sum | awk '{print $1}')
  saved=$(kc -n "$NS" get configmap hammurapi-key-fingerprint -o jsonpath='{.data.sha256}' 2>/dev/null || true)
  if [[ -n $saved && $saved != "$fp" ]]; then
    ((ALLOW_KEY_ROTATION)) || fail "$E_KEY" "the encryption key changed: stored user tokens become unreadable; to change it on purpose, use allow_key_rotation"
    warn "the token encryption key changed (allow_key_rotation): users will sign in again"
  fi
  kc -n "$NS" create configmap hammurapi-key-fingerprint --from-literal="sha256=$fp" --dry-run=client -o yaml | apply_stdin
}

copy_conn_secrets() {
  local name
  for name in postgres-conn kafka-conn s3-conn; do
    kc -n "$NS_STORAGES" get secret "$name" -o json 2>/dev/null |
      jq -c --arg ns "$NS" '
        {apiVersion: "v1", kind: "Secret", type: "Opaque",
         metadata: {name: .metadata.name, namespace: $ns, labels: {"app.kubernetes.io/managed-by": "hammurapi-deploy"}},
         data: .data}
        # For core: S3_ENDPOINT is host:port without a scheme, S3_USE_SSL follows the scheme.
        | if .metadata.name == "s3-conn" then
            (.data.endpoint | @base64d) as $e
            | .data.endpoint_host = ($e | sub("^https?://"; "") | sub("/.*$"; "") | @base64)
            | .data.use_ssl = ((if ($e | startswith("https://")) then "true" else "false" end) | @base64)
          else . end' | apply_json || fail "$E_SECRETS" "failed to copy $name from $NS_STORAGES"
  done
}

require_payload() {
  local missing=() k
  for k in "$@"; do
    [[ -n $(payload "$k") ]] || missing+=("${k#.}")
  done
  ((${#missing[@]} == 0)) || fail "$E_SECRETS" "missing from the configuration: ${missing[*]}"
}

sync_core_config() {
  step secrets
  require_payload .config.GIT_REPO .config.GITHUB_APP_ID .config.GITHUB_CLIENT_ID .config.BOOTSTRAP_ADMINS \
    .secrets.GITHUB_APP_PRIVATE_KEY .secrets.GITHUB_CLIENT_SECRET \
    .secrets.WEBHOOK_SECRET .secrets.TOKEN_ENCRYPTION_KEY
  check_key_fingerprint
  app_jwt
  APP_SLUG=$(github GET /app | jq -r '.slug // empty')
  [[ -n $APP_SLUG ]] || fail "$E_APP" "GitHub App is unavailable: check HAMMURAPI_GITHUB_APP_ID and the key"

  # Non-secret configuration → ConfigMap hammurapi-config.
  printf '%s' "$PAYLOAD" | jq -c --arg ns "$NS" --arg bot "${APP_SLUG}[bot]" '
    {apiVersion: "v1", kind: "ConfigMap",
     metadata: {name: "hammurapi-config", namespace: $ns, labels: {"app.kubernetes.io/managed-by": "hammurapi-deploy"}},
     data: ({GIT_PROVIDER: "github", HAMMURAPI_BOT_LOGIN: $bot} + (.config // {} | with_entries(.value |= tostring)))}' |
    apply_json || fail "$E_SECRETS" "failed to write hammurapi-config"

  # Secrets → Secret hammurapi-secrets. The agent operator token is gone:
  # the agent of Hammurapi is Nabu (FTR.HMR.CMN-0007 R3).
  printf '%s' "$PAYLOAD" | jq -c --arg ns "$NS" '
    (.secrets // {}) as $s
    | {apiVersion: "v1", kind: "Secret", type: "Opaque",
       metadata: {name: "hammurapi-secrets", namespace: $ns, labels: {"app.kubernetes.io/managed-by": "hammurapi-deploy"}},
       stringData: ($s | del(.DEPLOY_CALLBACK_SECRET, .ACP_AGENT_ENV)
         | .GITHUB_APP_PRIVATE_KEY = (.GITHUB_APP_PRIVATE_KEY | gsub("\\\\n"; "\n")))}' |
    apply_json || fail "$E_SECRETS" "failed to write hammurapi-secrets"

  copy_conn_secrets
  ok "configuration and secrets are in sync with GitHub"
}

# --- GitHub App ---

b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }

# app_jwt — the app JWT (RS256, 9 minutes); the key reaches openssl through /dev/fd.
app_jwt() {
  local now header body unsigned sig
  now=$(date +%s)
  header=$(printf '{"alg":"RS256","typ":"JWT"}' | b64url)
  body=$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' $((now - 60)) $((now + 540)) "$(payload .config.GITHUB_APP_ID)" | b64url)
  unsigned="$header.$body"
  sig=$(printf '%s' "$unsigned" | openssl dgst -sha256 -sign <(payload .secrets.GITHUB_APP_PRIVATE_KEY | sed 's/\\n/\n/g') | b64url) ||
    fail "$E_APP" "failed to sign the JWT with the GitHub App key"
  APP_JWT="$unsigned.$sig"
}

# github <method> <path> [JSON body from stdin] — the GitHub API as the app;
# the JWT header reaches curl through /dev/fd, not an argument.
github() {
  local method=$1 path=$2 data=()
  [[ $method != GET ]] && data=(--data-binary @-)
  curl -fsS --max-time 30 -X "$method" "${data[@]}" \
    -H @<(printf 'Authorization: Bearer %s\nAccept: application/vnd.github+json\nX-GitHub-Api-Version: 2022-11-28\n' "$APP_JWT") \
    "$GITHUB_API$path"
}

configure_app() {
  step github-app
  local repo inst perms url state
  repo=$(payload .config.GIT_REPO)
  url="https://${HAMMURAPI_API_HOST:-hammurapi-api}.$BASE_DOMAIN/hooks/v1/git"
  state=$(kc -n "$NS" get configmap hammurapi-deploy-state -o jsonpath='{.data.webhookUrl}' 2>/dev/null || true)
  if [[ $FIRST_INSTALL != true && $state == "$url" ]]; then
    debug "the GitHub App webhook address did not change"
    return
  fi
  # Address and secret of the app webhook (R13); the secret is in the jq body, not arguments.
  printf '%s' "$PAYLOAD" | jq -c --arg url "$url" '{url: $url, content_type: "json", secret: .secrets.WEBHOOK_SECRET, insecure_ssl: "0"}' |
    github PATCH /app/hook/config >/dev/null || fail "$E_APP" "failed to write the GitHub App webhook address"
  inst=$(github GET "/repos/$repo/installation" 2>/dev/null | jq -r '.id // empty') || true
  [[ -n $inst ]] || fail "$E_APP" "no access to $repo: install the app at https://github.com/apps/$APP_SLUG/installations/new"
  perms=$(github GET "/app/installations/$inst" | jq -c '{c: .permissions.contents, p: .permissions.pull_requests, e: (.events // [])}')
  if [[ $(jq -r '.c == "write" and .p == "write"' <<<"$perms") != true ]]; then
    fail "$E_APP" "the GitHub App lacks contents: write and pull_requests: write on $repo"
  fi
  if [[ $(jq -r '(.e | index("push")) != null and (.e | index("pull_request")) != null' <<<"$perms") != true ]]; then
    fail "$E_APP" "the GitHub App is not subscribed to push and pull_request events"
  fi
  kc -n "$NS" create configmap hammurapi-deploy-state --from-literal="webhookUrl=$url" --dry-run=client -o yaml | apply_stdin
  ok "GitHub App: webhook $url, access to $repo"
}

# --- 5. Helm ---

helm_login() {
  local token
  token=$(payload .ghcrPullToken)
  [[ -n $token ]] || token=$(kc -n "$NS" get secret ghcr-pull -o jsonpath='{.data.\.dockerconfigjson}' 2>/dev/null |
    base64 -d | jq -r --arg r "$REGISTRY" '.auths[$r].password // empty')
  [[ -n $token ]] || fail "$E_HELM" "no registry read token for the chart"
  # Registry credentials stay in tmpfs during the rollout.
  HELM_REG=$(mktemp -p /dev/shm hammurapi-helm-XXXXXX.json 2>/dev/null || mktemp)
  export HELM_REGISTRY_CONFIG=$HELM_REG
  printf '%s' "$token" | helm registry login "$REGISTRY" --username hammurapi --password-stdin >/dev/null 2>&1 ||
    fail "$E_HELM" "failed to sign in to $REGISTRY"
}

diagnostics() {
  local dir ts
  ts=$(date -u +%Y%m%dT%H%M%SZ)
  dir=$(mktemp -d)
  {
    kc -n "$NS" get events --sort-by=.lastTimestamp
  } >"$dir/events.txt" 2>&1 || true
  kc -n "$NS" get pods -o wide >"$dir/pods.txt" 2>&1 || true
  kc -n "$NS" describe pods >"$dir/describe-pods.txt" 2>&1 || true
  hm history "$COMPONENT" -n "$NS" >"$dir/helm-history.txt" 2>&1 || true
  kc -n "$NS" logs job/hammurapi-migrate --tail=500 >"$dir/migrate.log" 2>&1 || true
  kc -n "$NS" logs deploy/api --all-containers --tail=300 >"$dir/api.log" 2>&1 || true
  kc -n "$NS" logs deploy/worker --all-containers --tail=300 >"$dir/worker.log" 2>&1 || true
  local logs=${DEPLOY_LOGS:-/opt/installer/logs}
  [[ -d $logs && -w $logs ]] || logs=$ROOT/logs
  mkdir -p "$logs"
  DIAG=$logs/deploy-$COMPONENT-$ts.tar.gz
  tar -czf "$DIAG" -C "$dir" . && rm -rf "$dir"
}

helm_deploy() {
  step helm
  helm_login
  local image
  image=$(payload .image)
  local args=(upgrade --install "$COMPONENT" "$CHART_REPO/$COMPONENT" --version "$CHART_VERSION"
    -n "$NS" --set-string "image.tag=$TAG" --set-string "publicBaseDomain=$BASE_DOMAIN"
    --set-string "hosts.web=${HAMMURAPI_WEB_HOST:-hammurapi}" --set-string "hosts.api=${HAMMURAPI_API_HOST:-hammurapi-api}"
    --atomic --wait --timeout "${HELM_TIMEOUT:-10m}")
  local ingress=()
  mapfile -t ingress < <(ingress_helm_args)
  args+=("${ingress[@]}")
  [[ -n $image ]] && args+=(--set-string "image.repository=$image")
  log "helm upgrade --install $COMPONENT $TAG (chart $CHART_VERSION)"
  if ! hm "${args[@]}" >&2; then
    diagnostics
    fail "$E_HELM" "release $COMPONENT $TAG was not deployed, Helm restored the previous revision; diagnostics: $DIAG"
  fi
  wait_product_certificate "$NS" "$COMPONENT"
  REVISION=$(hm status "$COMPONENT" -n "$NS" -o json 2>/dev/null | jq -r '.version // empty')
}

# --- 7. Readiness ---

wait_ready() {
  step ready
  local d deploys=(web)
  [[ $COMPONENT == hammurapi-core ]] && deploys=(api worker)
  for d in "${deploys[@]}"; do
    if ! kc -n "$NS" rollout status "deploy/$d" --timeout=5m >/dev/null 2>&1; then
      diagnostics
      fail "$E_READY" "$d is not ready; diagnostics: $DIAG"
    fi
  done
  ok "$COMPONENT $TAG is ready (revision $REVISION)"
}

on_exit() {
  local rc=$?
  result "$rc"
  exit "$rc"
}

main() {
  trap on_exit EXIT
  # Colors before the first message: die uses them on an argument error.
  COLOR=0
  setup_color
  parse_args "$@"
  INSTALLER_CONFIG=$(installer_config)
  load_config "$ROOT" "$INSTALLER_CONFIG"
  acquire_deploy_lock
  read_payload
  check_stand
  check_order
  ensure_namespaces
  step secrets
  if [[ $COMPONENT == hammurapi-core ]]; then
    sync_core_config
  fi
  ghcr_pull
  helm_deploy
  if [[ $COMPONENT == hammurapi-core ]]; then
    configure_app
  fi
  wait_ready
}

main "$@"
